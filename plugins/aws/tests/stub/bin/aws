#!/usr/bin/env -S python3 -I
"""A stand-in for the aws CLI v2, for recording and replaying fixtures without an AWS account.

Put `tests/stub/bin` first on PATH and name a scenario:

    PATH=plugins/aws/tests/stub/bin:$PATH AWS_STUB_SCENARIO=healthy aws sts get-caller-identity ...

The scenario comes from `AWS_STUB_SCENARIO` and from nowhere else: the real runner (`rwtask run` /
`rwtask test --record`) strips every `RW_*` variable from the environment of the task it starts, so
only an `AWS_` name reaches the stub there. With the variable unset the stub refuses to run (exit 2)
instead of guessing a scenario; `tests/stub/record.sh` is the way to record, it always names one.

The call is looked up in `scenarios/<scenario>/calls.yaml` by its argv and answered with the canned
stdout file, stderr text and exit code recorded there. An argv that is not in the scenario exits 2
with a message that names it, so a test notices a call nobody planned for. Standard library only
(calls.yaml is written as JSON, which is YAML, so no YAML library is needed). See README.md.

The argv is normalised before the lookup: `--output json`, `-o json` and `--no-cli-pager` are
dropped, and the value after `--start-time` and `--end-time` becomes `<time>` (a run's clock is
not part of what a scenario describes). Nothing else is touched, in particular the order.
"""

import json
import os
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
SCENARIOS = HERE.parent / "scenarios"
TIME_FLAGS = ("--start-time", "--end-time")


def normalise(argv):
    """The argv as scenarios record it."""
    out = []
    i = 0
    while i < len(argv):
        word = argv[i]
        pair = argv[i : i + 2]
        if word == "--no-cli-pager":
            i += 1
        elif pair in (["--output", "json"], ["-o", "json"]):
            i += 2
        elif word in TIME_FLAGS and i + 1 < len(argv):
            out += [word, "<time>"]
            i += 2
        else:
            out.append(word)
            i += 1
    return out


def fail(message, code=2):
    sys.stderr.write(f"aws stub: {message}\n")
    return code


def main(argv):
    scenario = os.environ.get("AWS_STUB_SCENARIO") or ""
    if not scenario:
        return fail(
            "AWS_STUB_SCENARIO is not set: refusing to run. Name a directory under "
            "tests/stub/scenarios (tests/stub/record.sh does)"
        )
    if "/" in scenario or scenario.startswith("."):
        return fail("AWS_STUB_SCENARIO must name a directory under tests/stub/scenarios")
    directory = SCENARIOS / scenario
    calls_file = directory / "calls.yaml"
    if not calls_file.is_file():
        return fail(f"no scenario {scenario!r}: {calls_file} does not exist")
    wanted = normalise(argv)
    if wanted == ["--version"]:
        sys.stdout.write("aws-cli/2.39.3 Python/3.14.8 Linux/stub exe/stub\n")
        return 0
    calls = json.loads(calls_file.read_text(encoding="utf-8"))["calls"]
    log = os.environ.get("AWS_STUB_LOG")
    if log:  # tests read the argv list of every call, in order
        with open(log, "a", encoding="utf-8") as handle:
            handle.write(json.dumps(wanted) + "\n")
    for call in calls:
        if call["argv"] == wanted:
            if call.get("stdout"):
                source = (directory / call["stdout"]).resolve()
                if SCENARIOS.resolve() not in source.parents:
                    return fail(f"stdout file {call['stdout']!r} leaves the scenarios directory")
                sys.stdout.write(source.read_text(encoding="utf-8"))
            if call.get("stderr"):
                sys.stderr.write(call["stderr"])
            return int(call.get("rc", 0))
    return fail(
        f"scenario {scenario!r} has no canned response for: aws {' '.join(wanted)}\n"
        f"known calls ({len(calls)}):\n"
        + "\n".join(f"  aws {' '.join(c['argv'])}"[:180] for c in calls[:20])
        + ("\n  ..." if len(calls) > 20 else "")
    )


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
