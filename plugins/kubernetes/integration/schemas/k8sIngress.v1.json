{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ingress",
  "description": "Class, hosts, routing, TLS and the nginx annotations that govern the route.",
  "type": "object",
  "properties": {
    "class": {
      "type": [
        "string",
        "null"
      ]
    },
    "hosts": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "rules": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "host": {
            "type": [
              "string",
              "null"
            ]
          },
          "paths": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "service": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "port": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "tls": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "hosts": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "secretName": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "proxyBodySize": {
      "type": [
        "string",
        "null"
      ]
    },
    "proxyReadTimeout": {
      "type": [
        "string",
        "null"
      ]
    },
    "rewriteTarget": {
      "type": [
        "string",
        "null"
      ]
    },
    "authUrl": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
