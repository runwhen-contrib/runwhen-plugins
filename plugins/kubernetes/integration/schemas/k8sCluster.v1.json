{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cluster",
  "description": "Server version, inferred distribution, installed API groups and, when the nodes were readable, the node count.",
  "type": "object",
  "properties": {
    "serverVersion": {
      "type": "string"
    },
    "distribution": {
      "type": "string"
    },
    "apiGroups": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nodeCount": {
      "type": "integer"
    }
  },
  "required": [
    "serverVersion",
    "distribution",
    "apiGroups"
  ]
}
