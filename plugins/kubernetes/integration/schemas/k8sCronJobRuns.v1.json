{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CronJob recent runs",
  "description": "Outcomes of the last Jobs a CronJob owns, newest first.",
  "type": "object",
  "properties": {
    "lastJobs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "outcome": {
            "enum": [
              "succeeded",
              "failed",
              "running"
            ]
          },
          "startTime": {
            "type": [
              "string",
              "null"
            ]
          },
          "completionTime": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "required": [
    "lastJobs"
  ]
}
