{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pods",
  "description": "Rollup of the workload's pods (pods and ReplicaSets are read but never stored).",
  "type": "object",
  "properties": {
    "count": {
      "type": "integer"
    },
    "byPhase": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "ready": {
      "type": "integer"
    },
    "restartsTotal": {
      "type": "integer"
    },
    "restartsMax": {
      "type": "integer"
    },
    "lastTerminationReasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "imageIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "oldest": {
      "type": [
        "string",
        "null"
      ]
    },
    "newest": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "count",
    "byPhase",
    "ready",
    "restartsTotal",
    "restartsMax",
    "lastTerminationReasons",
    "nodes",
    "imageIds",
    "oldest",
    "newest"
  ]
}
