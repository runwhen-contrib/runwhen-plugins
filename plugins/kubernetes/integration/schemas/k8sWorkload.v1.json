{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workload spec",
  "description": "Images, resources, probes, service account and volume names of a workload's pod template.",
  "type": "object",
  "properties": {
    "replicas": {
      "type": [
        "integer",
        "null"
      ]
    },
    "serviceAccount": {
      "type": [
        "string",
        "null"
      ]
    },
    "hostNetwork": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "nodeSelector": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "containers": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "image": {
            "type": [
              "string",
              "null"
            ]
          },
          "requests": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "string"
            }
          },
          "limits": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "string"
            }
          },
          "ports": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "hasLivenessProbe": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "hasReadinessProbe": {
            "type": [
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "initContainers": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "image": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "volumes": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": [
          "string",
          "null"
        ]
      }
    }
  }
}
