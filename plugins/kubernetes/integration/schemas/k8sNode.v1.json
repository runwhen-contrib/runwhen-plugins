{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Node",
  "description": "Capacity, versions, placement, taints and conditions of a Node.",
  "type": "object",
  "properties": {
    "capacity": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "allocatable": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "kubeletVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "osImage": {
      "type": [
        "string",
        "null"
      ]
    },
    "containerRuntime": {
      "type": [
        "string",
        "null"
      ]
    },
    "instanceType": {
      "type": [
        "string",
        "null"
      ]
    },
    "zone": {
      "type": [
        "string",
        "null"
      ]
    },
    "taints": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": [
              "string",
              "null"
            ]
          },
          "value": {
            "type": [
              "string",
              "null"
            ]
          },
          "effect": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "unschedulable": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "conditions": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
