{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CronJob",
  "description": "Schedule, suspension, concurrency and last run times of a CronJob.",
  "type": "object",
  "properties": {
    "schedule": {
      "type": [
        "string",
        "null"
      ]
    },
    "suspend": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "concurrencyPolicy": {
      "type": [
        "string",
        "null"
      ]
    },
    "lastScheduleTime": {
      "type": [
        "string",
        "null"
      ]
    },
    "lastSuccessfulTime": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
