{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Autoscaling",
  "description": "Target, bounds, current and desired replicas of a HorizontalPodAutoscaler.",
  "type": "object",
  "properties": {
    "scaleTargetRef": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "apiVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "minReplicas": {
      "type": [
        "integer",
        "null"
      ]
    },
    "maxReplicas": {
      "type": [
        "integer",
        "null"
      ]
    },
    "currentReplicas": {
      "type": [
        "integer",
        "null"
      ]
    },
    "desiredReplicas": {
      "type": [
        "integer",
        "null"
      ]
    },
    "metrics": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": [
          "string",
          "null"
        ]
      }
    }
  }
}
