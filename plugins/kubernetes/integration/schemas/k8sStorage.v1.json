{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Storage",
  "description": "Claim, volume or class facts; the properties present depend on the type.",
  "type": "object",
  "properties": {
    "phase": {
      "type": [
        "string",
        "null"
      ]
    },
    "capacity": {
      "type": [
        "string",
        "null"
      ]
    },
    "requested": {
      "type": [
        "string",
        "null"
      ]
    },
    "accessModes": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "storageClass": {
      "type": [
        "string",
        "null"
      ]
    },
    "volumeName": {
      "type": [
        "string",
        "null"
      ]
    },
    "reclaimPolicy": {
      "type": [
        "string",
        "null"
      ]
    },
    "provisioner": {
      "type": [
        "string",
        "null"
      ]
    },
    "volumeBindingMode": {
      "type": [
        "string",
        "null"
      ]
    },
    "allowVolumeExpansion": {
      "type": [
        "boolean",
        "null"
      ]
    }
  }
}
