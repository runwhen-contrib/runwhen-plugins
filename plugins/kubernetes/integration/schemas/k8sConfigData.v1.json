{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Config data",
  "description": "Key names and hashes of a ConfigMap, or the key names and type of a Secret; never Secret values.",
  "type": "object",
  "properties": {
    "keys": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "immutable": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "dataHashes": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "type": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
