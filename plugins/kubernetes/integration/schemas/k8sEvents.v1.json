{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recent warning events",
  "description": "Warning events in the window, one entry per reason, newest first; pod events are attributed to the owning workload.",
  "type": "object",
  "properties": {
    "windowMinutes": {
      "type": "integer"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          },
          "lastSeen": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "windowMinutes",
    "warnings"
  ]
}
