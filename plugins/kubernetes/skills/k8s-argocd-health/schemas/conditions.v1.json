{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Application conditions; total counts them before the maxItems cut",
  "type": "object",
  "properties": {
    "total": {
      "type": "integer"
    },
    "truncated": {
      "type": "boolean"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024
          },
          "message": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024
          },
          "truncated": {
            "type": "boolean"
          },
          "lastTransitionTime": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024
          }
        },
        "required": [
          "type",
          "message",
          "truncated",
          "lastTransitionTime"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000
    }
  },
  "required": [
    "total",
    "truncated",
    "items"
  ],
  "additionalProperties": false
}
