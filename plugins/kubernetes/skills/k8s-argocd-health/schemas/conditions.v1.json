{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Application conditions",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "type": {
        "type": [
          "string",
          "null"
        ]
      },
      "message": {
        "type": [
          "string",
          "null"
        ],
        "maxLength": 1024
      },
      "truncated": {
        "type": "boolean"
      },
      "lastTransitionTime": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "type",
      "message",
      "truncated",
      "lastTransitionTime"
    ],
    "additionalProperties": false
  }
}
