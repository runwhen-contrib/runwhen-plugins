{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Whether the Application uses Helm and each Helm source",
  "type": "object",
  "properties": {
    "isHelm": {
      "type": "boolean"
    },
    "sourceCount": {
      "type": "integer"
    },
    "sourceTypes": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1024
      },
      "maxItems": 50
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer"
          },
          "repoURL": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024
          },
          "path": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024
          },
          "chart": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024
          },
          "targetRevision": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024
          },
          "ref": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024
          },
          "sourceType": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024
          },
          "releaseName": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024
          },
          "version": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024
          },
          "namespace": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024
          },
          "valueFiles": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 1024
            },
            "maxItems": 50
          },
          "valueFileCount": {
            "type": "integer"
          },
          "parameterNames": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 1024
            },
            "maxItems": 50
          },
          "parameterCount": {
            "type": "integer"
          },
          "fileParameterNames": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 1024
            },
            "maxItems": 50
          },
          "hasInlineValues": {
            "type": "boolean"
          },
          "skipCrds": {
            "type": "boolean"
          },
          "ignoreMissingValueFiles": {
            "type": "boolean"
          }
        },
        "required": [
          "index",
          "repoURL",
          "path",
          "chart",
          "targetRevision",
          "ref",
          "sourceType",
          "releaseName",
          "version",
          "namespace",
          "valueFiles",
          "valueFileCount",
          "parameterNames",
          "parameterCount",
          "fileParameterNames",
          "hasInlineValues",
          "skipCrds",
          "ignoreMissingValueFiles"
        ],
        "additionalProperties": false
      },
      "maxItems": 50
    }
  },
  "required": [
    "isHelm",
    "sourceCount",
    "sourceTypes",
    "sources"
  ],
  "additionalProperties": false
}
