{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repository, path or chart and tracked revision of each source (at most 50)",
  "type": "object",
  "properties": {
    "total": {
      "type": "integer"
    },
    "truncated": {
      "type": "boolean"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer"
          },
          "repoURL": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024
          },
          "path": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024
          },
          "chart": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024
          },
          "targetRevision": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024
          },
          "ref": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024
          },
          "sourceType": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024
          },
          "hasHelm": {
            "type": "boolean"
          }
        },
        "required": [
          "index",
          "repoURL",
          "path",
          "chart",
          "targetRevision",
          "ref",
          "sourceType",
          "hasHelm"
        ],
        "additionalProperties": false
      },
      "maxItems": 50
    }
  },
  "required": [
    "total",
    "truncated",
    "items"
  ],
  "additionalProperties": false
}
