{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repository, path or chart and tracked revision of each source",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "index": {
        "type": "integer"
      },
      "repoURL": {
        "type": [
          "string",
          "null"
        ]
      },
      "path": {
        "type": [
          "string",
          "null"
        ]
      },
      "chart": {
        "type": [
          "string",
          "null"
        ]
      },
      "targetRevision": {
        "type": [
          "string",
          "null"
        ]
      },
      "ref": {
        "type": [
          "string",
          "null"
        ]
      },
      "hasHelm": {
        "type": "boolean"
      }
    },
    "required": [
      "index",
      "repoURL",
      "path",
      "chart",
      "targetRevision",
      "ref",
      "hasHelm"
    ],
    "additionalProperties": false
  },
  "maxItems": 50
}
