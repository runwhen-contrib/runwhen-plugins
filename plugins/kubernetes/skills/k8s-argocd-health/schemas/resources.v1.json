{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Counts and the unhealthy or OutOfSync resources",
  "type": "object",
  "properties": {
    "total": {
      "type": "integer"
    },
    "matched": {
      "type": "integer"
    },
    "unhealthyCount": {
      "type": "integer"
    },
    "outOfSyncCount": {
      "type": "integer"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "group": {
            "type": "string"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "type": [
              "string",
              "null"
            ]
          },
          "namespace": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "syncStatus": {
            "type": [
              "string",
              "null"
            ]
          },
          "health": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024
          },
          "truncated": {
            "type": "boolean"
          },
          "hook": {
            "type": "boolean"
          },
          "requiresPruning": {
            "type": "boolean"
          }
        },
        "required": [
          "group",
          "version",
          "kind",
          "namespace",
          "name",
          "syncStatus",
          "health",
          "message",
          "truncated",
          "hook",
          "requiresPruning"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "total",
    "matched",
    "unhealthyCount",
    "outOfSyncCount",
    "items"
  ],
  "additionalProperties": false
}
