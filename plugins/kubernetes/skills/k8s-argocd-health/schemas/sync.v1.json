{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sync status and the revision(s) compared",
  "type": "object",
  "properties": {
    "status": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1024
    },
    "revision": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1024
    },
    "revisions": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1024
      },
      "maxItems": 50
    },
    "reconciledAt": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1024
    }
  },
  "required": [
    "status",
    "revision",
    "revisions",
    "reconciledAt"
  ],
  "additionalProperties": false
}
