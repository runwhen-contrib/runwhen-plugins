{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sync status and the revision(s) compared",
  "type": "object",
  "properties": {
    "status": {
      "type": [
        "string",
        "null"
      ]
    },
    "revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "revisions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 50
    },
    "reconciledAt": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "status",
    "revision",
    "revisions",
    "reconciledAt"
  ],
  "additionalProperties": false
}
