{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The latest status.history entry and how many there are",
  "type": "object",
  "properties": {
    "historyCount": {
      "type": "integer"
    },
    "entry": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "revisions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 50
        },
        "deployedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "deployStartedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "automated": {
          "type": "boolean"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "repoURL": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "path": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "chart": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "targetRevision": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "repoURL",
              "path",
              "chart",
              "targetRevision"
            ],
            "additionalProperties": false
          },
          "maxItems": 50
        }
      },
      "required": [
        "id",
        "revision",
        "revisions",
        "deployedAt",
        "deployStartedAt",
        "automated",
        "sources"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "historyCount",
    "entry"
  ],
  "additionalProperties": false
}
