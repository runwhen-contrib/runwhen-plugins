{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Health status and message",
  "type": "object",
  "properties": {
    "status": {
      "type": [
        "string",
        "null"
      ]
    },
    "message": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1024
    },
    "truncated": {
      "type": "boolean"
    },
    "lastTransitionTime": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "status",
    "message",
    "truncated",
    "lastTransitionTime"
  ],
  "additionalProperties": false
}
