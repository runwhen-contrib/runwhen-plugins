{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Identity, destination and sync policy of the Application",
  "type": "object",
  "properties": {
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "namespace": {
      "type": [
        "string",
        "null"
      ]
    },
    "project": {
      "type": [
        "string",
        "null"
      ]
    },
    "destination": {
      "type": "object",
      "properties": {
        "server": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "namespace": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "server",
        "name",
        "namespace"
      ],
      "additionalProperties": false
    },
    "deletionTimestamp": {
      "type": [
        "string",
        "null"
      ]
    },
    "operationInProgress": {
      "type": "boolean"
    },
    "resourceCount": {
      "type": "integer"
    },
    "sourceTypes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 50
    },
    "syncPolicy": {
      "type": "object",
      "properties": {
        "automated": {
          "type": "boolean"
        },
        "prune": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "selfHeal": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "allowEmpty": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "syncOptions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 50
        },
        "retryLimit": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "automated",
        "prune",
        "selfHeal",
        "allowEmpty",
        "syncOptions",
        "retryLimit"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "name",
    "namespace",
    "project",
    "destination",
    "deletionTimestamp",
    "operationInProgress",
    "resourceCount",
    "sourceTypes",
    "syncPolicy"
  ],
  "additionalProperties": false
}
