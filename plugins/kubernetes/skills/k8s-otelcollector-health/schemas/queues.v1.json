{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Collector exporter sending queues",
  "description": "otelcol_exporter_queue_size against queue_capacity per pod, exporter and data type (traces, metrics, logs; null on a version that does not label the queue by data type). utilizationPercent is size over capacity (null when either is not reported); atOrAboveThreshold compares it with the queueUtilizationPercent setting (thresholdPercent); full is size at or above capacity: new data is refused or dropped by that exporter. Worst first. An exporter without a sending queue (for example debug) has no entry.",
  "type": "object",
  "properties": {
    "thresholdPercent": {
      "type": "number"
    },
    "count": {
      "type": "integer"
    },
    "truncated": {
      "type": "boolean"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pod": {
            "type": "string"
          },
          "exporter": {
            "type": "string"
          },
          "dataType": {
            "type": [
              "string",
              "null"
            ]
          },
          "size": {
            "type": [
              "integer",
              "null"
            ]
          },
          "capacity": {
            "type": [
              "integer",
              "null"
            ]
          },
          "utilizationPercent": {
            "type": [
              "number",
              "null"
            ]
          },
          "atOrAboveThreshold": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "full": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "pod",
          "exporter",
          "dataType",
          "size",
          "capacity",
          "utilizationPercent",
          "atOrAboveThreshold",
          "full"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "thresholdPercent",
    "count",
    "truncated",
    "items"
  ],
  "additionalProperties": false
}
