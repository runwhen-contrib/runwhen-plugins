{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Multi-replica workloads no PodDisruptionBudget selects",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "kind": {
        "enum": [
          "Deployment",
          "StatefulSet"
        ]
      },
      "name": {
        "type": "string"
      },
      "replicas": {
        "type": "integer"
      }
    },
    "required": [
      "kind",
      "name",
      "replicas"
    ],
    "additionalProperties": false
  }
}
