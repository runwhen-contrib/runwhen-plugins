{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResourceQuota usage per resource",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "quota": {
        "type": "string"
      },
      "resource": {
        "type": "string"
      },
      "used": {
        "type": [
          "string",
          "null"
        ]
      },
      "hard": {
        "type": "string"
      },
      "ratio": {
        "type": [
          "number",
          "null"
        ]
      },
      "atOrAbove": {
        "type": [
          "boolean",
          "null"
        ]
      },
      "scopes": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "scopeSelector": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "scopeName": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "operator": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "values": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "scopeName",
                "operator",
                "values"
              ],
              "additionalProperties": false
            }
          }
        ]
      }
    },
    "required": [
      "quota",
      "resource",
      "used",
      "hard",
      "ratio",
      "atOrAbove",
      "scopes",
      "scopeSelector"
    ],
    "additionalProperties": false
  }
}
