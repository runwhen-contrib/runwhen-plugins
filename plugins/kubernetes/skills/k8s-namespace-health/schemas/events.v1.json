{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Warning events grouped by object and reason",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "kind": {
        "type": [
          "string",
          "null"
        ]
      },
      "name": {
        "type": [
          "string",
          "null"
        ]
      },
      "reason": {
        "type": [
          "string",
          "null"
        ]
      },
      "count": {
        "type": "integer"
      },
      "firstSeen": {
        "type": [
          "string",
          "null"
        ]
      },
      "lastSeen": {
        "type": [
          "string",
          "null"
        ]
      },
      "message": {
        "type": [
          "string",
          "null"
        ]
      },
      "reportingComponent": {
        "type": [
          "string",
          "null"
        ]
      },
      "uid": {
        "type": [
          "string",
          "null"
        ]
      },
      "truncated": {
        "type": "boolean"
      },
      "objectExists": {
        "type": [
          "boolean",
          "null"
        ]
      },
      "owner": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "resolved": {
                "type": "boolean"
              }
            },
            "required": [
              "kind",
              "name",
              "resolved"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "required": [
      "kind",
      "name",
      "reason",
      "count",
      "firstSeen",
      "lastSeen",
      "message",
      "reportingComponent",
      "uid",
      "truncated",
      "objectExists",
      "owner"
    ],
    "additionalProperties": false
  }
}
