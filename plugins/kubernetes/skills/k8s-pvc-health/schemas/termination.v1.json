{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Whether the claim is being deleted",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "phase": {
      "type": [
        "string",
        "null"
      ]
    },
    "terminating": {
      "type": "boolean"
    },
    "deletionTimestamp": {
      "type": [
        "string",
        "null"
      ]
    },
    "terminatingSeconds": {
      "type": [
        "integer",
        "null"
      ]
    },
    "finalizers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 50
    },
    "gracePeriodSeconds": {
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "required": [
    "name",
    "phase",
    "terminating",
    "deletionTimestamp",
    "terminatingSeconds",
    "finalizers",
    "gracePeriodSeconds"
  ],
  "additionalProperties": false
}
