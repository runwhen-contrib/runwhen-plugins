{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VolumeAttachments for the claim's PersistentVolume (null when they could not be listed)",
  "type": [
    "array",
    "null"
  ],
  "items": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string"
      },
      "node": {
        "type": [
          "string",
          "null"
        ]
      },
      "attacher": {
        "type": [
          "string",
          "null"
        ]
      },
      "attached": {
        "type": "boolean"
      },
      "attachError": {
        "type": [
          "string",
          "null"
        ],
        "maxLength": 1024
      },
      "attachErrorTime": {
        "type": [
          "string",
          "null"
        ]
      },
      "detachError": {
        "type": [
          "string",
          "null"
        ],
        "maxLength": 1024
      },
      "detachErrorTime": {
        "type": [
          "string",
          "null"
        ]
      },
      "nodeHasMountingPod": {
        "type": "boolean"
      },
      "terminating": {
        "type": "boolean"
      },
      "truncated": {
        "type": "boolean"
      }
    },
    "required": [
      "name",
      "node",
      "attacher",
      "attached",
      "attachError",
      "attachErrorTime",
      "detachError",
      "detachErrorTime",
      "nodeHasMountingPod",
      "terminating",
      "truncated"
    ],
    "additionalProperties": false
  }
}
