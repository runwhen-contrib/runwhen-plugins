{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Access modes and the nodes live pods mount the claim from (null when the pods could not be listed)",
  "type": "object",
  "properties": {
    "accessModes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 50
    },
    "readWriteOnce": {
      "type": "boolean"
    },
    "volumeName": {
      "type": [
        "string",
        "null"
      ]
    },
    "nodes": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      },
      "maxItems": 50
    },
    "multiNodeConflict": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "nodeCount": {
      "type": [
        "integer",
        "null"
      ]
    },
    "truncated": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "terminatingNodes": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      },
      "maxItems": 50
    },
    "readWriteOncePod": {
      "type": "boolean"
    }
  },
  "required": [
    "accessModes",
    "readWriteOnce",
    "volumeName",
    "nodes",
    "multiNodeConflict",
    "nodeCount",
    "truncated",
    "terminatingNodes",
    "readWriteOncePod"
  ],
  "additionalProperties": false
}
