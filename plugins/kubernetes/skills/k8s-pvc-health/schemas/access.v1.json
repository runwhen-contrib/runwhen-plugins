{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Access modes and the nodes active pods mount the claim from",
  "type": "object",
  "properties": {
    "accessModes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 50
    },
    "readWriteOnce": {
      "type": "boolean"
    },
    "volumeName": {
      "type": [
        "string",
        "null"
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 50
    },
    "multiNodeConflict": {
      "type": "boolean"
    }
  },
  "required": [
    "accessModes",
    "readWriteOnce",
    "volumeName",
    "nodes",
    "multiNodeConflict"
  ],
  "additionalProperties": false
}
