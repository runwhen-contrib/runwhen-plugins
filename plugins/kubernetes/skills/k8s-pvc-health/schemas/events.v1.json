{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Events about the claim grouped by type and reason",
  "type": [
    "array",
    "null"
  ],
  "items": {
    "type": "object",
    "properties": {
      "type": {
        "type": [
          "string",
          "null"
        ]
      },
      "reason": {
        "type": [
          "string",
          "null"
        ]
      },
      "count": {
        "type": "integer"
      },
      "firstSeen": {
        "type": [
          "string",
          "null"
        ]
      },
      "lastSeen": {
        "type": [
          "string",
          "null"
        ]
      },
      "message": {
        "type": [
          "string",
          "null"
        ],
        "maxLength": 1024
      },
      "reportingComponent": {
        "type": [
          "string",
          "null"
        ]
      },
      "truncated": {
        "type": "boolean"
      }
    },
    "required": [
      "type",
      "reason",
      "count",
      "firstSeen",
      "lastSeen",
      "message",
      "reportingComponent",
      "truncated"
    ],
    "additionalProperties": false
  }
}
