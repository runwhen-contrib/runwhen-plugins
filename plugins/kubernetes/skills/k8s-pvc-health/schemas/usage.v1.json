{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Filesystem usage of the mounted volume",
  "type": "object",
  "properties": {
    "pod": {
      "type": "string"
    },
    "container": {
      "type": "string"
    },
    "mountPath": {
      "type": "string"
    },
    "filesystem": {
      "type": "string"
    },
    "sizeBytes": {
      "type": "integer"
    },
    "usedBytes": {
      "type": "integer"
    },
    "availableBytes": {
      "type": "integer"
    },
    "percent": {
      "type": [
        "number",
        "null"
      ]
    },
    "thresholdPercent": {
      "type": "number"
    },
    "atOrAbove": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "runningPods": {
      "type": "integer"
    }
  },
  "required": [
    "pod",
    "container",
    "mountPath",
    "filesystem",
    "sizeBytes",
    "usedBytes",
    "availableBytes",
    "percent",
    "thresholdPercent",
    "atOrAbove",
    "runningPods"
