{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The PersistentVolumeClaim's binding state",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "namespace": {
      "type": [
        "string",
        "null"
      ]
    },
    "phase": {
      "type": [
        "string",
        "null"
      ]
    },
    "storageClassName": {
      "type": [
        "string",
        "null"
      ]
    },
    "volumeName": {
      "type": [
        "string",
        "null"
      ]
    },
    "volumeMode": {
      "type": [
        "string",
        "null"
      ]
    },
    "accessModes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 50
    },
    "capacity": {
      "type": "object",
      "properties": {
        "requested": {
          "type": [
            "string",
            "null"
          ]
        },
        "requestedBytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "bound": {
          "type": [
            "string",
            "null"
          ]
        },
        "boundBytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "boundBelowRequested": {
          "type": "boolean"
        }
      },
      "required": [
        "requested",
        "requestedBytes",
        "bound",
        "boundBytes",
        "boundBelowRequested"
      ],
      "additionalProperties": false
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024
          },
          "lastTransition": {
            "type": [
              "string",
              "null"
            ]
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "type",
          "status",
          "reason",
          "message",
          "lastTransition",
          "truncated"
        ],
        "additionalProperties": false
      },
      "maxItems": 50
    },
    "deletionTimestamp": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "name",
    "namespace",
    "phase",
    "storageClassName",
    "volumeName",
    "volumeMode",
    "accessModes",
    "capacity",
    "conditions",
    "deletionTimestamp"
  ],
  "additionalProperties": false
}
