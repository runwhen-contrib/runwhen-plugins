{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Replica counts of each Vault StatefulSet",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string"
      },
      "namespace": {
        "type": [
          "string",
          "null"
        ]
      },
      "desired": {
        "type": "integer"
      },
      "current": {
        "type": "integer"
      },
      "ready": {
        "type": "integer"
      },
      "updated": {
        "type": "integer"
      },
      "available": {
        "type": "integer"
      },
      "generation": {
        "type": [
          "integer",
          "null"
        ]
      },
      "observedGeneration": {
        "type": [
          "integer",
          "null"
        ]
      },
      "generationObserved": {
        "type": [
          "boolean",
          "null"
        ]
      },
      "updateStrategy": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "name",
      "namespace",
      "desired",
      "current",
      "ready",
      "updated",
      "available",
      "generation",
      "observedGeneration",
      "generationObserved",
      "updateStrategy"
    ],
    "additionalProperties": false
  }
}
