{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Warning events about the DaemonSet and its pods",
  "description": "Last seen within the since window, grouped by object and reason, newest first. count is the sum of the events' own lifetime counters. Events expire after about an hour on most clusters, so an empty list is not proof nothing happened earlier.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "kind": {
        "type": [
          "string",
          "null"
        ]
      },
      "name": {
        "type": [
          "string",
          "null"
        ]
      },
      "reason": {
        "type": [
          "string",
          "null"
        ]
      },
      "count": {
        "type": "integer"
      },
      "firstSeen": {
        "type": [
          "string",
          "null"
        ]
      },
      "lastSeen": {
        "type": [
          "string",
          "null"
        ]
      },
      "message": {
        "type": [
          "string",
          "null"
        ]
      },
      "truncated": {
        "type": "boolean"
      }
    },
    "required": [
      "kind",
      "name",
      "reason",
      "count",
      "firstSeen",
      "lastSeen",
      "message",
      "truncated"
    ],
    "additionalProperties": false
  }
}
