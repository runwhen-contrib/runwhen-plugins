{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Counts of each Vault CSI provider DaemonSet",
  "description": "unavailableExceedsMax compares numberUnavailable with the DaemonSet's own rolling-update maxUnavailable (default 1; a percentage is of the desired count, rounded up).",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string"
      },
      "namespace": {
        "type": [
          "string",
          "null"
        ]
      },
      "desired": {
        "type": "integer"
      },
      "current": {
        "type": "integer"
      },
      "ready": {
        "type": "integer"
      },
      "updated": {
        "type": "integer"
      },
      "available": {
        "type": "integer"
      },
      "unavailable": {
        "type": "integer"
      },
      "misscheduled": {
        "type": "integer"
      },
      "generation": {
        "type": [
          "integer",
          "null"
        ]
      },
      "observedGeneration": {
        "type": [
          "integer",
          "null"
        ]
      },
      "generationObserved": {
        "type": [
          "boolean",
          "null"
        ]
      },
      "updateStrategy": {
        "type": [
          "string",
          "null"
        ]
      },
      "maxUnavailable": {
        "type": "integer"
      },
      "unavailableExceedsMax": {
        "type": "boolean"
      }
    },
    "required": [
      "name",
      "namespace",
      "desired",
      "current",
      "ready",
      "updated",
      "available",
      "unavailable",
      "misscheduled",
      "generation",
      "observedGeneration",
      "generationObserved",
      "updateStrategy",
      "maxUnavailable",
      "unavailableExceedsMax"
    ],
    "additionalProperties": false
  }
}
