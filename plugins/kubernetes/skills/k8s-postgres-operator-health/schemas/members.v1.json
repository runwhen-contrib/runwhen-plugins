{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Member pods",
  "description": "The database pods of the cluster, selected by the operator's labels. Null with a permission_denied error when the pods could not be listed.",
  "type": [
    "object",
    "null"
  ],
  "properties": {
    "selector": {
      "type": [
        "string"
      ]
    },
    "count": {
      "type": [
        "integer"
      ]
    },
    "readyCount": {
      "type": [
        "integer"
      ]
    },
    "truncated": {
      "type": [
        "boolean"
      ]
    },
    "items": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "phase": {
            "type": [
              "string",
              "null"
            ]
          },
          "ready": {
            "type": [
              "boolean"
            ]
          },
          "restarts": {
            "type": [
              "integer"
            ]
          },
          "role": {
            "type": [
              "string",
              "null"
            ]
          },
          "primary": {
            "type": [
              "boolean"
            ]
          },
          "node": {
            "type": [
              "string",
              "null"
            ]
          },
          "startTime": {
            "type": [
              "string",
              "null"
            ]
          },
          "deleting": {
            "type": [
              "boolean"
            ]
          },
          "containers": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "init": {
                  "type": [
                    "boolean"
                  ]
                },
                "ready": {
                  "type": [
                    "boolean"
                  ]
                },
                "restartCount": {
                  "type": [
                    "integer"
                  ]
                },
                "state": {
                  "enum": [
                    "running",
                    "waiting",
                    "terminated",
                    null
                  ]
                },
                "reason": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "name",
                "init",
                "ready",
                "restartCount",
                "state",
                "reason"
              ]
            }
          }
        },
        "required": [
          "name",
          "phase",
          "ready",
          "restarts",
          "role",
          "primary",
          "node",
          "startTime",
          "deleting",
          "containers"
        ]
      }
    }
  },
  "required": [
    "selector",
    "count",
    "readyCount",
    "truncated",
    "items"
  ]
}
