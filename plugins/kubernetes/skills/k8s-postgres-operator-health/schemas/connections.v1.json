{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Connections",
  "description": "Client connections on the primary, excluding the session that asked. total is compared with max_connections minus superuser_reserved_connections. No query text is returned.",
  "type": "object",
  "properties": {
    "queried": {
      "type": "object",
      "properties": {
        "pod": {
          "type": [
            "string"
          ]
        },
        "container": {
          "type": [
            "string"
          ]
        }
      },
      "required": [
        "pod",
        "container"
      ]
    },
    "primaryCandidates": {
      "type": [
        "integer"
      ]
    },
    "inRecovery": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "maxConnections": {
      "type": [
        "integer"
      ]
    },
    "superuserReserved": {
      "type": [
        "integer"
      ]
    },
    "usableConnections": {
      "type": [
        "integer"
      ]
    },
    "total": {
      "type": [
        "integer"
      ]
    },
    "byState": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "integer"
        ]
      }
    },
    "utilizationPercent": {
      "type": [
        "number",
        "null"
      ]
    },
    "utilizationThresholdPercent": {
      "type": [
        "number"
      ]
    },
    "aboveThreshold": {
      "type": [
        "boolean"
      ]
    },
    "longestQuerySeconds": {
      "type": [
        "integer",
        "null"
      ]
    },
    "longestIdleInTransactionSeconds": {
      "type": [
        "integer",
        "null"
      ]
    },
    "waitingLocks": {
      "type": [
        "integer"
      ]
    },
    "sessionsWaitingOnLock": {
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "required": [
    "queried",
    "primaryCandidates",
    "inRecovery",
    "maxConnections",
    "superuserReserved",
    "usableConnections",
    "total",
    "byState",
    "utilizationPercent",
    "utilizationThresholdPercent",
    "aboveThreshold",
    "longestQuerySeconds",
    "longestIdleInTransactionSeconds",
    "waitingLocks",
    "sessionsWaitingOnLock"
  ]
}
