{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Log streams read (one per container current or previous log)",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "pod": {
        "type": "string"
      },
      "container": {
        "type": "string"
      },
      "init": {
        "type": "boolean"
      },
      "previous": {
        "type": "boolean"
      },
      "lines": {
        "type": "integer"
      },
      "linesFetched": {
        "type": "integer"
      },
      "truncated": {
        "type": "boolean"
      },
      "bytesCut": {
        "type": "boolean"
      },
      "lineTruncated": {
        "type": "boolean"
      }
    },
    "required": [
      "pod",
      "container",
      "init",
      "previous",
      "lines",
      "linesFetched",
      "truncated",
      "bytesCut",
      "lineTruncated"
    ],
    "additionalProperties": false
  }
}
