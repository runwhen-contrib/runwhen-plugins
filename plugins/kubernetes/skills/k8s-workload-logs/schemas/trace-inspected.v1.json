{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "As logs-inspected, plus traces seen after the group limit was reached (counted, not grouped)",
  "type": "object",
  "properties": {
    "pods": {
      "type": "integer"
    },
    "podsRead": {
      "type": "integer"
    },
    "containersExcluded": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 50
    },
    "bytesRead": {
      "type": "integer"
    },
    "total": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "omitted": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "tracesUngrouped": {
      "type": "integer"
    }
  },
  "required": [
    "pods",
    "podsRead",
    "containersExcluded",
    "bytesRead",
    "total",
    "omitted",
    "tracesUngrouped"
  ],
  "additionalProperties": false
}
