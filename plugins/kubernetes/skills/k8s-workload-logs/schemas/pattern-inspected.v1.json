{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "pods": {
      "type": "integer"
    },
    "podsRead": {
      "type": "integer"
    },
    "containersExcluded": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 50
    },
    "linesIgnored": {
      "type": "integer"
    }
  },
  "required": [
    "pods",
    "podsRead",
    "containersExcluded",
    "linesIgnored"
  ],
  "additionalProperties": false,
  "title": "Which pods and containers were looked at, and lines skipped by the ignore setting"
}
