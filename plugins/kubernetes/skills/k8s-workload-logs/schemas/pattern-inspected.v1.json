{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "As logs-inspected, plus lines skipped by the ignore setting",
  "type": "object",
  "properties": {
    "pods": {
      "type": "integer"
    },
    "podsRead": {
      "type": "integer"
    },
    "containersExcluded": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 50
    },
    "bytesRead": {
      "type": "integer"
    },
    "total": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "omitted": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "linesIgnored": {
      "type": "integer"
    }
  },
  "required": [
    "pods",
    "podsRead",
    "containersExcluded",
    "bytesRead",
    "total",
    "omitted",
    "linesIgnored"
  ],
  "additionalProperties": false
}
