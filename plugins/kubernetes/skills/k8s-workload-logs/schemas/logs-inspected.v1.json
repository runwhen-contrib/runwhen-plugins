{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "pods": {
      "type": "integer"
    },
    "podsRead": {
      "type": "integer"
    },
    "containersExcluded": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 50
    }
  },
  "required": [
    "pods",
    "podsRead",
    "containersExcluded"
  ],
  "additionalProperties": false,
  "title": "Which pods and containers were looked at"
}
