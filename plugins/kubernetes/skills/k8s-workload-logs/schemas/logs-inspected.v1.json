{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pods and containers looked at, bytes read, and list sizes (total entries and entries left out by maxItems)",
  "type": "object",
  "properties": {
    "pods": {
      "type": "integer"
    },
    "podsRead": {
      "type": "integer"
    },
    "containersExcluded": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 50
    },
    "bytesRead": {
      "type": "integer"
    },
    "total": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "omitted": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    }
  },
  "required": [
    "pods",
    "podsRead",
    "containersExcluded",
    "bytesRead",
    "total",
    "omitted"
  ],
  "additionalProperties": false
}
