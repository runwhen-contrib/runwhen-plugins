{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Matching line counts per container and category",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "pod": {
        "type": "string"
      },
      "container": {
        "type": "string"
      },
      "previous": {
        "type": "boolean"
      },
      "category": {
        "type": "string"
      },
      "count": {
        "type": "integer"
      },
      "samples": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 1024
        },
        "maxItems": 3
      },
      "truncated": {
        "type": "boolean"
      }
    },
    "required": [
      "pod",
      "container",
      "previous",
      "category",
      "count",
      "samples",
      "truncated"
    ],
    "additionalProperties": false
  }
}
