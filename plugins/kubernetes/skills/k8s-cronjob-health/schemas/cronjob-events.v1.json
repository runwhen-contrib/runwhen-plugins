{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Events about the CronJob",
  "description": "Null when the events could not be listed. The routine SuccessfulCreate, SawCompletedJob and SuccessfulDelete events are left out.",
  "type": [
    "array",
    "null"
  ],
  "items": {
    "type": "object",
    "properties": {
      "type": {
        "type": [
          "string",
          "null"
        ]
      },
      "reason": {
        "type": [
          "string",
          "null"
        ]
      },
      "count": {
        "type": "integer"
      },
      "firstSeen": {
        "type": [
          "string",
          "null"
        ]
      },
      "lastSeen": {
        "type": "string"
      },
      "message": {
        "type": [
          "string",
          "null"
        ]
      },
      "truncated": {
        "type": "boolean"
      }
    },
    "required": [
      "type",
      "reason",
      "count",
      "firstSeen",
      "lastSeen",
      "message",
      "truncated"
    ],
    "additionalProperties": false
  }
}
