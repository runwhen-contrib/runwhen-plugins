{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jobs the CronJob lists as active",
  "description": "Jobs in status.active. exists and the detail fields are null when the Jobs could not be listed.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "name": {
        "type": [
          "string",
          "null"
        ]
      },
      "exists": {
        "type": [
          "boolean",
          "null"
        ]
      },
      "startTime": {
        "type": [
          "string",
          "null"
        ]
      },
      "runningSeconds": {
        "type": [
          "integer",
          "null"
        ]
      },
      "activePods": {
        "type": [
          "integer",
          "null"
        ]
      },
      "succeededPods": {
        "type": [
          "integer",
          "null"
        ]
      },
      "failedPods": {
        "type": [
          "integer",
          "null"
        ]
      }
    },
    "required": [
      "name",
      "exists",
      "startTime",
      "runningSeconds",
      "activePods",
      "succeededPods",
      "failedPods"
    ],
    "additionalProperties": false
  }
}
