{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Run totals",
  "description": "owned and latestStatus cover every Job the CronJob still owns, in or out of the window; the status counts cover the window, before the maxItems cap.",
  "type": "object",
  "properties": {
    "owned": {
      "type": "integer"
    },
    "inWindow": {
      "type": "integer"
    },
    "succeeded": {
      "type": "integer"
    },
    "failed": {
      "type": "integer"
    },
    "active": {
      "type": "integer"
    },
    "activeBeforeWindow": {
      "type": "integer"
    },
    "latestStatus": {
      "enum": [
        "succeeded",
        "failed",
        "active",
        null
      ]
    },
    "latestStartTime": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "owned",
    "inWindow",
    "succeeded",
    "failed",
    "active",
    "activeBeforeWindow",
    "latestStatus",
    "latestStartTime"
  ],
  "additionalProperties": false
}
