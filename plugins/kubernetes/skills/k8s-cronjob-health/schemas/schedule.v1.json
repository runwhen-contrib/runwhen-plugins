{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CronJob schedule facts",
  "description": "The CronJob's schedule, suspension and last-run fields, and what the schedule says should have happened by now. The evaluated fields (lastExpectedFire to deadlineExceeded) are null when the schedule could not be evaluated (see the schedule-scoped error).",
  "type": "object",
  "properties": {
    "suspended": {
      "type": "boolean"
    },
    "schedule": {
      "type": [
        "string",
        "null"
      ]
    },
    "timeZone": {
      "type": [
        "string",
        "null"
      ]
    },
    "concurrencyPolicy": {
      "type": "string"
    },
    "startingDeadlineSeconds": {
      "type": [
        "integer",
        "null"
      ]
    },
    "creationTimestamp": {
      "type": [
        "string",
        "null"
      ]
    },
    "lastScheduleTime": {
      "type": [
        "string",
        "null"
      ]
    },
    "lastSuccessfulTime": {
      "type": [
        "string",
        "null"
      ]
    },
    "successOlderThanLastSchedule": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "activeCount": {
      "type": "integer"
    },
    "forbidBlocked": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "lastExpectedFire": {
      "type": [
        "string",
        "null"
      ]
    },
    "nextExpectedFire": {
      "type": [
        "string",
        "null"
      ]
    },
    "evaluatedTimeZone": {
      "type": [
        "string",
        "null"
      ]
    },
    "missedFires": {
      "type": [
        "integer",
        "null"
      ]
    },
    "missedFiresCapped": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "missedSince": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "behindSchedule": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "deadlineExceeded": {
      "type": [
        "boolean",
        "null"
      ]
    }
  },
  "required": [
    "suspended",
    "schedule",
    "timeZone",
    "concurrencyPolicy",
    "startingDeadlineSeconds",
    "creationTimestamp",
    "lastScheduleTime",
    "lastSuccessfulTime",
    "successOlderThanLastSchedule",
    "activeCount",
    "forbidBlocked",
    "lastExpectedFire",
    "nextExpectedFire",
    "evaluatedTimeZone",
    "missedFires",
    "missedFiresCapped",
    "missedSince",
    "behindSchedule",
    "deadlineExceeded"
  ],
  "additionalProperties": false
}
