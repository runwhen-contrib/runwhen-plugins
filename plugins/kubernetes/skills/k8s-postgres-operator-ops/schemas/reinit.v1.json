{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reinitialise one Patroni member",
  "description": "applied is true when patronictl accepted the command; a dry run sets wouldRun and runs nothing. reinit only starts the re-clone: stateAfter is read once right after (typically creating replica), not waited for.",
  "type": "object",
  "properties": {
    "applied": {
      "type": [
        "boolean"
      ]
    },
    "wouldRun": {
      "type": [
        "boolean"
      ]
    },
    "member": {
      "type": [
        "string"
      ]
    },
    "role": {
      "type": [
        "string",
        "null"
      ]
    },
    "stateBefore": {
      "type": [
        "string",
        "null"
      ]
    },
    "lagBeforeMb": {
      "type": [
        "number",
        "null"
      ]
    },
    "leader": {
      "type": [
        "string",
        "null"
      ]
    },
    "command": {
      "type": "object",
      "properties": {
        "tool": {
          "const": "patronictl"
        },
        "subcommand": {
          "type": [
            "string"
          ]
        },
        "cluster": {
          "type": [
            "string"
          ]
        },
        "member": {
          "type": [
            "string"
          ]
        }
      },
      "required": [
        "tool",
        "subcommand",
        "cluster"
      ]
    },
    "ranIn": {
      "type": "object",
      "properties": {
        "pod": {
          "type": [
            "string"
          ]
        },
        "container": {
          "type": [
            "string"
          ]
        }
      },
      "required": [
        "pod",
        "container"
      ]
    },
    "output": {
      "type": [
        "string",
        "null"
      ]
    },
    "outputTruncated": {
      "type": [
        "boolean"
      ]
    },
    "stateAfter": {
      "type": [
        "string",
        "null"
      ]
    },
    "roleAfter": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "applied",
    "wouldRun",
    "member",
    "role",
    "stateBefore",
    "lagBeforeMb",
    "leader",
    "command",
    "ranIn",
    "output",
    "outputTruncated",
    "stateAfter",
    "roleAfter"
  ]
}
