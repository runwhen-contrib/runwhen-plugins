{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rolling restart",
  "description": "Crunchy: the restart annotation (spec.metadata.annotations.restarted, which the operator copies to the pod templates of every pod it runs for the cluster) set to requestedAt (method annotation); completed is true when as many instance pods as the spec asks for are Ready and were restarted at or after requestedAt. Zalando: patronictl restart <cluster> <member> --force, one member at a time, replicas first and the leader last (method patronictl); memberResults has each member's outcome; completed is true when every member printed its Success line and was back running or streaming with its Pending restart cleared. null means not waited or not observed.",
  "type": "object",
  "properties": {
    "applied": {
      "type": [
        "boolean"
      ]
    },
    "wouldRun": {
      "type": [
        "boolean"
      ]
    },
    "method": {
      "enum": [
        "annotation",
        "patronictl"
      ]
    },
    "requestedAt": {
      "type": [
        "string"
      ]
    },
    "membersExpected": {
      "type": [
        "integer",
        "null"
      ]
    },
    "annotation": {
      "type": [
        "string",
        "null"
      ]
    },
    "previousAnnotation": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1024
    },
    "command": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "tool": {
              "const": "patronictl"
            },
            "subcommand": {
              "type": [
                "string"
              ]
            },
            "cluster": {
              "type": [
                "string"
              ]
            },
            "member": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "tool",
            "subcommand",
            "cluster",
            "member"
          ]
        }
      ]
    },
    "ranIn": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "pod": {
              "type": [
                "string"
              ]
            },
            "container": {
              "type": [
                "string"
              ]
            }
          },
          "required": [
            "pod",
            "container"
          ]
        }
      ]
    },
    "completed": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "completionReason": {
      "enum": [
        "restarted",
        "running",
        "timeout",
        "budget",
        "member_failed",
        "not_observed",
        "not_waited",
        null
      ]
    },
    "waitedSeconds": {
      "type": [
        "number",
        "null"
      ]
    },
    "membersFound": {
      "type": [
        "integer",
        "null"
      ]
    },
    "membersReady": {
      "type": [
        "integer",
        "null"
      ]
    },
    "membersRestarted": {
      "type": [
        "integer",
        "null"
      ]
    },
    "members": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "phase": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "ready": {
                "type": [
                  "boolean"
                ]
              },
              "role": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "startTime": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "restartAnnotation": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 1024
              },
              "state": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "timeline": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "lagMb": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "pendingRestart": {
                "type": [
                  "boolean"
                ]
              }
            },
            "required": [
              "name"
            ]
          }
        }
      ]
    },
    "memberResults": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "properties": {
              "member": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "role": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "order": {
                "type": [
                  "integer"
                ]
              },
              "status": {
                "enum": [
                  "planned",
                  "restarted",
                  "not_back",
                  "failed",
                  "unconfirmed",
                  "not_attempted"
                ]
              },
              "applied": {
                "type": [
                  "boolean"
                ]
              },
              "stateBefore": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "pendingRestartBefore": {
                "type": [
                  "boolean"
                ]
              },
              "stateAfter": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "pendingRestartAfter": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "waitedSeconds": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "output": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 1024
              },
              "outputTruncated": {
                "type": [
                  "boolean"
                ]
              },
              "detail": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 1024
              },
              "detailTruncated": {
                "type": [
                  "boolean"
                ]
              }
            },
            "required": [
              "member",
              "role",
              "order",
              "status",
              "applied",
              "stateBefore",
              "pendingRestartBefore",
              "stateAfter",
              "pendingRestartAfter",
              "waitedSeconds",
              "output",
              "outputTruncated",
              "detail",
              "detailTruncated"
            ]
          }
        }
      ]
    }
  },
  "required": [
    "applied",
    "wouldRun",
    "method",
    "requestedAt",
    "membersExpected",
    "annotation",
    "previousAnnotation",
    "command",
    "ranIn",
    "completed",
    "completionReason",
    "waitedSeconds",
    "membersFound",
    "membersReady",
    "membersRestarted",
    "members",
    "memberResults"
  ]
}
