{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rollout restart result",
  "description": "applied is false on a dry run. completed is null when no wait happened (dry run); false with a completionReason when the rollout was slow, stuck or not observable.",
  "type": "object",
  "properties": {
    "applied": {
      "type": "boolean"
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "reasonRecorded": {
      "type": "boolean"
    },
    "restartedAt": {
      "type": "string"
    },
    "updateStrategy": {
      "type": [
        "string",
        "null"
      ]
    },
    "revisionBefore": {
      "type": [
        "integer",
        "null"
      ]
    },
    "revisionAfter": {
      "type": [
        "integer",
        "null"
      ]
    },
    "completed": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "completionReason": {
      "enum": [
        "rolled_out",
        "timeout",
        "progress_deadline_exceeded",
        "update_strategy_on_delete",
        "not_observed",
        null
      ]
    },
    "message": {
      "type": [
        "string",
        "null"
      ]
    },
    "truncated": {
      "type": "boolean"
    },
    "waitedSeconds": {
      "type": [
        "number",
        "null"
      ]
    }
  },
  "required": [
    "applied",
    "reason",
    "reasonRecorded",
    "restartedAt",
    "updateStrategy",
    "revisionBefore",
    "revisionAfter",
    "completed",
    "completionReason",
    "message",
    "truncated",
    "waitedSeconds"
  ],
  "additionalProperties": false
}
