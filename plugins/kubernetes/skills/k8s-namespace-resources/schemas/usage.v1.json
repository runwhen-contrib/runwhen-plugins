{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Container usage against requests and limits",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "pod": {
        "type": "string"
      },
      "container": {
        "type": "string"
      },
      "init": {
        "type": "boolean"
      },
      "resource": {
        "enum": [
          "cpu",
          "memory"
        ]
      },
      "unit": {
        "enum": [
          "millicores",
          "bytes"
        ]
      },
      "usage": {
        "type": [
          "number",
          "null"
        ]
      },
      "request": {
        "type": [
          "number",
          "null"
        ]
      },
      "limit": {
        "type": [
          "number",
          "null"
        ]
      },
      "percentOfLimit": {
        "type": [
          "number",
          "null"
        ]
      },
      "percentOfRequest": {
        "type": [
          "number",
          "null"
        ]
      },
      "atOrAbove": {
        "type": [
          "boolean",
          "null"
        ]
      },
      "timestamp": {
        "type": [
          "string",
          "null"
        ]
      },
      "window": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "pod",
      "container",
      "init",
      "resource",
      "unit",
      "usage",
      "request",
      "limit",
      "percentOfLimit",
      "percentOfRequest",
      "atOrAbove",
      "timestamp",
      "window"
    ],
    "additionalProperties": false
  }
}
