{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Containers in workload pod templates without a request or limit; null when no workload list could be read",
  "type": [
    "array",
    "null"
  ],
  "items": {
    "type": "object",
    "properties": {
      "kind": {
        "enum": [
          "Deployment",
          "StatefulSet",
          "DaemonSet"
        ]
      },
      "name": {
        "type": "string"
      },
      "container": {
        "type": "string"
      },
      "init": {
        "type": "boolean"
      },
      "cpuRequest": {
        "type": [
          "string",
          "null"
        ]
      },
      "cpuLimit": {
        "type": [
          "string",
          "null"
        ]
      },
      "memoryRequest": {
        "type": [
          "string",
          "null"
        ]
      },
      "memoryLimit": {
        "type": [
          "string",
          "null"
        ]
      },
      "missing": {
        "type": "array",
        "items": {
          "enum": [
            "cpuRequest",
            "cpuLimit",
            "memoryRequest",
            "memoryLimit"
          ]
        }
      }
    },
    "required": [
      "kind",
      "name",
      "container",
      "init",
      "cpuRequest",
      "cpuLimit",
      "memoryRequest",
      "memoryLimit",
      "missing"
    ],
    "additionalProperties": false
  }
}
