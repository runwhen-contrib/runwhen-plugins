{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Image of every container",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "pod": {
        "type": "string"
      },
      "phase": {
        "type": [
          "string",
          "null"
        ]
      },
      "container": {
        "type": "string"
      },
      "init": {
        "type": "boolean"
      },
      "image": {
        "type": "string"
      },
      "repository": {
        "type": "string"
      },
      "tag": {
        "type": [
          "string",
          "null"
        ]
      },
      "digest": {
        "type": [
          "string",
          "null"
        ]
      },
      "pullPolicy": {
        "type": [
          "string",
          "null"
        ]
      },
      "imageID": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "pod",
      "phase",
      "container",
      "init",
      "image",
      "repository",
      "tag",
      "digest",
      "pullPolicy",
      "imageID"
    ],
    "additionalProperties": false
  }
}
