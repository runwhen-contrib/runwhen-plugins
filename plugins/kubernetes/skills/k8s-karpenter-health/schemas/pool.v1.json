{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NodePool conditions, disruption settings and NodeClass reference",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "generation": {
      "type": [
        "integer",
        "null"
      ]
    },
    "creationTimestamp": {
      "type": [
        "string",
        "null"
      ]
    },
    "ready": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "truncated": {
          "type": "boolean"
        },
        "lastTransitionTime": {
          "type": [
            "string",
            "null"
          ]
        },
        "observedGeneration": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "type",
        "status",
        "reason",
        "message",
        "truncated",
        "lastTransitionTime",
        "observedGeneration"
      ],
      "additionalProperties": false
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "truncated": {
            "type": "boolean"
          },
          "lastTransitionTime": {
            "type": [
              "string",
              "null"
            ]
          },
          "observedGeneration": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "type",
          "status",
          "reason",
          "message",
          "truncated",
          "lastTransitionTime",
          "observedGeneration"
        ],
        "additionalProperties": false
      },
      "maxItems": 50
    },
    "notTrueConditions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 50,
      "description": "Types of the conditions whose status is not True"
    },
    "weight": {
      "type": [
        "integer",
        "null"
      ]
    },
    "consolidationPolicy": {
      "type": [
        "string",
        "null"
      ]
    },
    "consolidateAfter": {
      "type": [
        "string",
        "null"
      ]
    },
    "expireAfter": {
      "type": [
        "string",
        "null"
      ]
    },
    "budgets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nodes": {
            "type": [
              "string",
              "null"
            ]
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 50
          },
          "schedule": {
            "type": [
              "string",
              "null"
            ]
          },
          "duration": {
            "type": [
              "string",
              "null"
            ]
          },
          "allowsNone": {
            "type": "boolean"
          },
          "allowsNoneDuringSchedule": {
            "type": "boolean"
          }
        },
        "required": [
          "nodes",
          "reasons",
          "schedule",
          "duration",
          "allowsNone",
          "allowsNoneDuringSchedule"
        ],
        "additionalProperties": false
      },
      "maxItems": 50,
      "description": "spec.disruption.budgets as set; allowsNone: nodes is 0 or 0% with no schedule; allowsNoneDuringSchedule: the same with a schedule (blocks only inside its window)"
    },
    "budgetCount": {
      "type": "integer"
    },
    "nodeClassRef": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "group": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "group",
        "kind",
        "name"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "name",
    "generation",
    "creationTimestamp",
    "ready",
    "conditions",
    "notTrueConditions",
    "weight",
    "consolidationPolicy",
    "consolidateAfter",
    "expireAfter",
    "budgets",
    "budgetCount",
    "nodeClassRef"
  ],
  "additionalProperties": false
}
