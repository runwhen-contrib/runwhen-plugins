{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unschedulable pods the NodePool could serve",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "namespace": {
        "type": [
          "string",
          "null"
        ]
      },
      "name": {
        "type": "string"
      },
      "uid": {
        "type": [
          "string",
          "null"
        ]
      },
      "ageSeconds": {
        "type": [
          "integer",
          "null"
        ]
      },
      "unschedulableSeconds": {
        "type": [
          "integer",
          "null"
        ]
      },
      "constraint": {
        "type": "string",
        "enum": [
          "nodeSelector",
          "nodeAffinity",
          "nodeAffinityOther",
          "none"
        ]
      },
      "message": {
        "type": [
          "string",
          "null"
        ]
      },
      "truncated": {
        "type": "boolean"
      },
      "requests": {
        "type": "object",
        "properties": {
          "cpuMillicores": {
            "type": [
              "number",
              "null"
            ]
          },
          "memoryBytes": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "cpuMillicores",
          "memoryBytes"
        ],
        "additionalProperties": false
      },
      "owner": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "name"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "namespace",
      "name",
      "uid",
      "ageSeconds",
      "unschedulableSeconds",
      "constraint",
      "message",
      "truncated",
      "requests",
      "owner"
    ],
    "additionalProperties": false
  }
}
