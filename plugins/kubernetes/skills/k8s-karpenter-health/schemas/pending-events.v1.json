{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Events on the pending pods, per pod and reason",
  "type": [
    "array",
    "null"
  ],
  "items": {
    "type": "object",
    "properties": {
      "namespace": {
        "type": [
          "string",
          "null"
        ]
      },
      "pod": {
        "type": "string"
      },
      "reason": {
        "type": [
          "string",
          "null"
        ]
      },
      "type": {
        "type": [
          "string",
          "null"
        ]
      },
      "count": {
        "type": "integer"
      },
      "firstSeen": {
        "type": [
          "string",
          "null"
        ]
      },
      "lastSeen": {
        "type": [
          "string",
          "null"
        ]
      },
      "message": {
        "type": [
          "string",
          "null"
        ]
      },
      "reportingComponent": {
        "type": [
          "string",
          "null"
        ]
      },
      "truncated": {
        "type": "boolean"
      }
    },
    "required": [
      "namespace",
      "pod",
      "reason",
      "type",
      "count",
      "firstSeen",
      "lastSeen",
      "message",
      "reportingComponent",
      "truncated"
    ],
    "additionalProperties": false
  },
  "description": "null when events were not read: no pod was listed, or listing them was forbidden (permission_denied error scoped events). [] means they were read and none fell inside since"
}
