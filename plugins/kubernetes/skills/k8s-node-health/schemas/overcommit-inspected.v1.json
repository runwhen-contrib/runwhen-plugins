{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "How many nodes and pods were counted and which pods were not",
  "type": "object",
  "properties": {
    "nodes": {
      "type": "integer"
    },
    "pods": {
      "type": "integer"
    },
    "podsUnscheduled": {
      "type": "integer"
    },
    "podsTerminated": {
      "type": "integer"
    },
    "podsOnOtherNodes": {
      "type": "integer"
    }
  },
  "required": [
    "nodes",
    "pods",
    "podsUnscheduled",
    "podsTerminated",
    "podsOnOtherNodes"
  ],
  "additionalProperties": false
}
