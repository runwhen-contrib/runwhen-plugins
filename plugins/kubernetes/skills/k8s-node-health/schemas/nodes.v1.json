{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Per node: Ready condition, pressure conditions, cordon, taints, kubelet version, age",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string"
      },
      "ready": {
        "type": "object",
        "properties": {
          "status": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024
          },
          "truncated": {
            "type": "boolean"
          },
          "lastTransition": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "status",
          "reason",
          "message",
          "truncated",
          "lastTransition"
        ],
        "additionalProperties": false
      },
      "conditions": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "status": {
              "type": [
                "string",
                "null"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "message": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 1024
            },
            "truncated": {
              "type": "boolean"
            },
            "lastTransition": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "type",
            "status",
            "reason",
            "message",
            "truncated",
            "lastTransition"
          ],
          "additionalProperties": false
        },
        "maxItems": 50
      },
      "unschedulable": {
        "type": "boolean"
      },
      "taints": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "type": [
                "string",
                "null"
              ]
            },
            "effect": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "key",
            "effect"
          ],
          "additionalProperties": false
        },
        "maxItems": 50
      },
      "kubeletVersion": {
        "type": [
          "string",
          "null"
        ]
      },
      "created": {
        "type": [
          "string",
          "null"
        ]
      },
      "ageSeconds": {
        "type": [
          "integer",
          "null"
        ]
      }
    },
    "required": [
      "name",
      "ready",
      "conditions",
      "unschedulable",
      "taints",
      "kubeletVersion",
      "created",
      "ageSeconds"
    ],
    "additionalProperties": false
  }
}
