{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nodes whose Ready condition changed state within the look-back window",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "node": {
        "type": "string"
      },
      "status": {
        "type": [
          "string",
          "null"
        ]
      },
      "reason": {
        "type": [
          "string",
          "null"
        ]
      },
      "lastTransition": {
        "type": "string"
      },
      "secondsAgo": {
        "type": "integer"
      }
    },
    "required": [
      "node",
      "status",
      "reason",
      "lastTransition",
      "secondsAgo"
    ],
    "additionalProperties": false
  }
}
