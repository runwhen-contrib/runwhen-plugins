{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Per node: summed pod requests and limits against allocatable for CPU and memory",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string"
      },
      "pods": {
        "type": "integer"
      },
      "podCapacity": {
        "type": [
          "integer",
          "null"
        ]
      },
      "allocatable": {
        "type": "object",
        "properties": {
          "cpuMillicores": {
            "type": [
              "number",
              "null"
            ]
          },
          "memoryBytes": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "cpuMillicores",
          "memoryBytes"
        ],
        "additionalProperties": false
      },
      "cpu": {
        "type": "object",
        "properties": {
          "requestsMillicores": {
            "type": [
              "number",
              "null"
            ]
          },
          "requestsPercent": {
            "type": [
              "number",
              "null"
            ]
          },
          "requestsAboveAllocatable": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "containersWithoutRequests": {
            "type": "integer"
          },
          "limitsMillicores": {
            "type": [
              "number",
              "null"
            ]
          },
          "limitsPercent": {
            "type": [
              "number",
              "null"
            ]
          },
          "limitsAboveAllocatable": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "containersWithoutLimits": {
            "type": "integer"
          }
        },
        "required": [
          "requestsMillicores",
          "requestsPercent",
          "requestsAboveAllocatable",
          "containersWithoutRequests",
          "limitsMillicores",
          "limitsPercent",
          "limitsAboveAllocatable",
          "containersWithoutLimits"
        ],
        "additionalProperties": false
      },
      "memory": {
        "type": "object",
        "properties": {
          "requestsBytes": {
            "type": [
              "integer",
              "null"
            ]
          },
          "requestsPercent": {
            "type": [
              "number",
              "null"
            ]
          },
          "requestsAboveAllocatable": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "containersWithoutRequests": {
            "type": "integer"
          },
          "limitsBytes": {
            "type": [
              "integer",
              "null"
            ]
          },
          "limitsPercent": {
            "type": [
              "number",
              "null"
            ]
          },
          "limitsAboveAllocatable": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "containersWithoutLimits": {
            "type": "integer"
          }
        },
        "required": [
          "requestsBytes",
          "requestsPercent",
          "requestsAboveAllocatable",
          "containersWithoutRequests",
          "limitsBytes",
          "limitsPercent",
          "limitsAboveAllocatable",
          "containersWithoutLimits"
        ],
        "additionalProperties": false
      },
      "requestsAboveAllocatable": {
        "type": [
          "boolean",
          "null"
        ]
      },
      "limitsAboveAllocatable": {
        "type": [
          "boolean",
          "null"
        ]
      }
    },
    "required": [
      "name",
      "pods",
      "podCapacity",
      "allocatable",
      "cpu",
      "memory",
      "requestsAboveAllocatable",
      "limitsAboveAllocatable"
    ],
    "additionalProperties": false
  }
}
