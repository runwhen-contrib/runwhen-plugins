{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Node restart events within the look-back window grouped per node and reason; null when they could not be read",
  "type": [
    "array",
    "null"
  ],
  "items": {
    "type": "object",
    "properties": {
      "node": {
        "type": "string"
      },
      "total": {
        "type": "integer"
      },
      "lastSeen": {
        "type": "string"
      },
      "reasons": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string"
            },
            "type": {
              "type": [
                "string",
                "null"
              ]
            },
            "count": {
              "type": "integer"
            },
            "firstSeen": {
              "type": "string"
            },
            "lastSeen": {
              "type": "string"
            },
            "message": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 1024
            },
            "reportingComponent": {
              "type": [
                "string",
                "null"
              ]
            },
            "truncated": {
              "type": "boolean"
            }
          },
          "required": [
            "reason",
            "type",
            "count",
            "firstSeen",
            "lastSeen",
            "message",
            "reportingComponent",
            "truncated"
          ],
          "additionalProperties": false
        },
        "maxItems": 50
      }
    },
    "required": [
      "node",
      "total",
      "lastSeen",
      "reasons"
    ],
    "additionalProperties": false
  }
}
