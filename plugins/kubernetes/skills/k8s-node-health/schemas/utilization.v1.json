{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Per node: metrics.k8s.io usage against allocatable for CPU and memory",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string"
      },
      "timestamp": {
        "type": [
          "string",
          "null"
        ]
      },
      "window": {
        "type": [
          "string",
          "null"
        ]
      },
      "cpu": {
        "type": "object",
        "properties": {
          "usageMillicores": {
            "type": [
              "number",
              "null"
            ]
          },
          "allocatableMillicores": {
            "type": [
              "number",
              "null"
            ]
          },
          "percent": {
            "type": [
              "number",
              "null"
            ]
          },
          "atOrAbove": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "usageMillicores",
          "allocatableMillicores",
          "percent",
          "atOrAbove"
        ],
        "additionalProperties": false
      },
      "memory": {
        "type": "object",
        "properties": {
          "usageBytes": {
            "type": [
              "integer",
              "null"
            ]
          },
          "allocatableBytes": {
            "type": [
              "integer",
              "null"
            ]
          },
          "percent": {
            "type": [
              "number",
              "null"
            ]
          },
          "atOrAbove": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "usageBytes",
          "allocatableBytes",
          "percent",
          "atOrAbove"
        ],
        "additionalProperties": false
      },
      "atOrAbove": {
        "type": [
          "boolean",
          "null"
        ]
      }
    },
    "required": [
      "name",
      "timestamp",
      "window",
      "cpu",
      "memory",
      "atOrAbove"
    ],
    "additionalProperties": false
  }
}
