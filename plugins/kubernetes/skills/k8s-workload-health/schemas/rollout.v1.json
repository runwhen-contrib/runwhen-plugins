    "name",
    "namespace",
    "generation",
    "observedGeneration",
    "generationObserved",
    "paused",
    "desired",
    "replicas",
    "ready",
    "updated",
    "available",
    "unavailable",
    "misscheduled",
    "updateStrategy",
    "partition",
    "currentRevision",
    "updateRevision",
    "progressDeadlineSeconds",
    "progressDeadlineExceeded",
    "conditions"
