    "namespace": {
      "type": [
        "string",
        "null"
      ]
    },
    "generation": {
      "type": [
        "integer",
        "null"
      ]
    },
    "observedGeneration": {
      "type": [
        "integer",
        "null"
      ]
    },
    "generationObserved": {
      "type": "boolean"
    },
    "paused": {
      "type": "boolean"
    },
    "desired": {
      "type": "integer"
    },
    "replicas": {
      "type": "integer"
    },
    "ready": {
      "type": "integer"
    },
    "updated": {
      "type": "integer"
    },
    "available": {
      "type": "integer"
    },
    "unavailable": {
      "type": "integer"
    },
    "misscheduled": {
      "type": [
        "integer",
        "null"
      ]
    },
    "updateStrategy": {
      "type": [
        "string",
        "null"
      ]
    },
    "partition": {
      "type": [
        "integer",
        "null"
      ]
    },
    "currentRevision": {
      "type": [
        "string",
        "null"
      ]
    },
    "updateRevision": {
      "type": [
        "string",
        "null"
      ]
    },
    "progressDeadlineSeconds": {
      "type": [
        "integer",
        "null"
      ]
    },
    "progressDeadlineExceeded": {
      "type": "boolean"
