{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HorizontalPodAutoscalers targeting the workload",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string"
      },
      "minReplicas": {
        "type": "integer"
      },
      "maxReplicas": {
        "type": [
          "integer",
          "null"
        ]
      },
      "currentReplicas": {
        "type": "integer"
      },
      "desiredReplicas": {
        "type": [
          "integer",
          "null"
        ]
      },
      "atMax": {
        "type": [
          "boolean",
          "null"
        ]
      },
      "atMin": {
        "type": [
          "boolean",
          "null"
        ]
      },
      "lastScaleTime": {
        "type": [
          "string",
          "null"
        ]
      },
      "conditions": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "message": {
              "type": [
                "string",
                "null"
              ]
            },
            "lastTransitionTime": {
              "type": [
                "string",
                "null"
              ]
            },
            "truncated": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "status",
            "reason",
            "message",
            "lastTransitionTime"
          ],
          "additionalProperties": false
        }
      },
      "metrics": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "container": {
              "type": [
                "string",
                "null"
              ]
            },
            "targetType": {
              "type": [
                "string",
                "null"
              ]
            },
            "target": {
              "type": [
                "integer",
                "number",
                "string",
                "null"
              ]
            },
            "current": {
              "type": [
                "integer",
                "number",
                "string",
                "null"
              ]
            },
            "containersWithoutRequests": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "type",
            "name",
            "container",
            "targetType",
            "target",
            "current",
            "containersWithoutRequests"
          ],
          "additionalProperties": false
        }
      },
      "defaultCpuTarget": {
        "type": [
          "integer",
          "null"
        ]
      },
      "resourceMetricWithoutRequests": {
        "type": "boolean"
      },
      "truncated": {
        "type": "boolean"
      }
    },
    "required": [
      "name",
      "minReplicas",
      "maxReplicas",
      "currentReplicas",
      "desiredReplicas",
      "atMax",
      "atMin",
      "lastScaleTime",
      "conditions",
      "metrics",
      "defaultCpuTarget",
      "resourceMetricWithoutRequests"
    ],
    "additionalProperties": false
  }
}
