{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Revisions created in the window, diffed against the previous revision",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "revision": {
        "type": "integer"
      },
      "name": {
        "type": "string"
      },
      "current": {
        "type": "boolean"
      },
      "reused": {
        "type": "boolean"
      },
      "windowBasis": {
        "enum": [
          "created",
          "progressing"
        ]
      },
      "created": {
        "type": [
          "string",
          "null"
        ]
      },
      "previousRevision": {
        "type": [
          "integer",
          "null"
        ]
      },
      "images": {
        "type": "object",
        "additionalProperties": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "imageChanges": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "container": {
              "type": "string"
            },
            "from": {
              "type": [
                "string",
                "null"
              ]
            },
            "to": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "container",
            "from",
            "to"
          ],
          "additionalProperties": false
        }
      },
      "envAdded": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "container": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "container",
            "name"
          ],
          "additionalProperties": false
        }
      },
      "envRemoved": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "container": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "container",
            "name"
          ],
          "additionalProperties": false
        }
      },
      "envChanged": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "container": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "container",
            "name"
          ],
          "additionalProperties": false
        }
      },
      "otherPodSpecChanged": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "resourceChanges": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "container": {
              "type": "string"
            },
            "from": {
              "type": "object"
            },
            "to": {
              "type": "object"
            }
          },
          "required": [
            "container",
            "from",
            "to"
          ],
          "additionalProperties": false
        }
      },
      "containersAdded": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "containersRemoved": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "truncated": {
        "type": "boolean"
      }
    },
    "required": [
      "revision",
      "name",
      "current",
      "reused",
      "windowBasis",
      "created",
      "previousRevision",
      "images",
      "imageChanges",
      "envAdded",
      "envRemoved",
      "envChanged",
      "otherPodSpecChanged",
      "resourceChanges",
      "containersAdded",
      "containersRemoved"
    ],
    "additionalProperties": false
  }
}
