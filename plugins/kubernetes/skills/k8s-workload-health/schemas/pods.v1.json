{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pod status per pod",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string"
      },
      "phase": {
        "type": [
          "string",
          "null"
        ]
      },
      "reason": {
        "type": [
          "string",
          "null"
        ]
      },
      "message": {
        "type": [
          "string",
          "null"
        ]
      },
      "ready": {
        "type": "boolean"
      },
      "containersReady": {
        "type": "integer"
      },
      "containersTotal": {
        "type": "integer"
      },
      "node": {
        "type": [
          "string",
          "null"
        ]
      },
      "scheduled": {
        "type": [
          "boolean",
          "null"
        ]
      },
      "unschedulable": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "properties": {
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "message": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "reason",
              "message"
            ],
            "additionalProperties": false
          }
        ]
      },
      "waiting": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "container": {
              "type": "string"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "message": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "container",
            "reason",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "terminated": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "container": {
              "type": "string"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "exitCode": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "container",
            "reason",
            "exitCode"
          ],
          "additionalProperties": false
        }
      },
      "startTime": {
        "type": [
          "string",
          "null"
        ]
      },
      "deletionTimestamp": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "name",
      "phase",
      "reason",
      "message",
      "ready",
      "containersReady",
      "containersTotal",
      "node",
      "scheduled",
      "unschedulable",
      "waiting",
      "terminated",
      "startTime",
      "deletionTimestamp"
    ],
    "additionalProperties": false
  }
}
