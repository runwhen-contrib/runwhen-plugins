{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Containers that restarted",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "pod": {
        "type": "string"
      },
      "container": {
        "type": "string"
      },
      "init": {
        "type": "boolean"
      },
      "restartCount": {
        "type": "integer"
      },
      "ready": {
        "type": "boolean"
      },
      "state": {
        "type": [
          "string",
          "null"
        ]
      },
      "waitingReason": {
        "type": [
          "string",
          "null"
        ]
      },
      "lastTerminated": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "properties": {
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "exitCode": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "signal": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "startedAt": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "finishedAt": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "reason",
              "exitCode",
              "signal",
              "startedAt",
              "finishedAt"
            ],
            "additionalProperties": false
          }
        ]
      },
      "recent": {
        "type": "boolean"
      },
      "exceedsThreshold": {
        "type": "boolean"
      }
    },
    "required": [
      "pod",
      "container",
      "init",
      "restartCount",
      "ready",
      "state",
      "waitingReason",
      "lastTerminated",
      "recent",
      "exceedsThreshold"
    ],
    "additionalProperties": false
  }
}
