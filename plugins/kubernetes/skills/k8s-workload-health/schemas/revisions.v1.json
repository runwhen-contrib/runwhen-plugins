{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workload revisions, newest first",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string"
      },
      "revision": {
        "type": [
          "integer",
          "null"
        ]
      },
      "current": {
        "type": "boolean"
      },
      "reused": {
        "type": "boolean"
      },
      "earlierRevisions": {
        "type": "array",
        "items": {
          "type": "integer"
        }
      },
      "created": {
        "type": [
          "string",
          "null"
        ]
      },
      "images": {
        "type": "object",
        "additionalProperties": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "replicas": {
        "type": [
          "integer",
          "null"
        ]
      },
      "ready": {
        "type": [
          "integer",
          "null"
        ]
      }
    },
    "required": [
      "name",
      "revision",
      "current",
      "reused",
      "earlierRevisions",
      "created",
      "images",
      "replicas",
      "ready"
    ],
    "additionalProperties": false
  }
}
