{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "What was looked at",
  "type": "object",
  "properties": {
    "pods": {
      "type": "integer"
    },
    "podsRead": {
      "type": "integer"
    },
    "podsNotRead": {
      "type": "integer",
      "description": "Readable pods left out by maxPods"
    },
    "sinceSeconds": {
      "type": "integer"
    },
    "total": {
      "type": "object",
      "properties": {
        "proxies": {
          "type": "integer"
        },
        "unavailable": {
          "type": "integer"
        }
      },
      "required": [
        "proxies",
        "unavailable"
      ]
    },
    "omitted": {
      "type": "object",
      "properties": {
        "proxies": {
          "type": "integer"
        },
        "unavailable": {
          "type": "integer"
        }
      },
      "required": [
        "proxies",
        "unavailable"
      ]
    }
  },
  "required": [
    "pods",
    "podsRead",
    "podsNotRead",
    "sinceSeconds",
    "total",
    "omitted"
  ]
