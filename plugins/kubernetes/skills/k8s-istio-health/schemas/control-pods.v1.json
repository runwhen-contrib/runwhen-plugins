{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pods of the Deployment, most restarts first; null when the pods could not be read",
  "type": [
    "array",
    "null"
  ],
  "items": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string"
      },
      "phase": {
        "type": [
          "string",
          "null"
        ]
      },
      "ready": {
        "type": "boolean"
      },
      "node": {
        "type": [
          "string",
          "null"
        ]
      },
      "terminating": {
        "type": "boolean"
      },
      "restartCount": {
        "type": "integer"
      },
      "containers": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "init": {
              "type": "boolean"
            },
            "ready": {
              "type": "boolean"
            },
            "restartCount": {
              "type": "integer"
            },
            "state": {
              "type": [
                "string",
                "null"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "lastTerminated": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "reason": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "exitCode": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "finishedAt": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "reason",
                "exitCode",
                "finishedAt"
              ]
            }
          },
          "required": [
            "name",
            "init",
            "ready",
            "restartCount",
            "state",
            "reason",
            "lastTerminated"
          ]
        }
      },
      "truncated": {
        "type": "boolean"
      }
    },
    "required": [
      "name",
      "phase",
      "ready",
      "node",
      "terminating",
      "restartCount",
      "containers",
      "truncated"
    ]
  }
}
