{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Replica counts and conditions of the Deployment",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "replicas": {
      "type": "integer"
    },
    "readyReplicas": {
      "type": "integer"
    },
    "availableReplicas": {
      "type": "integer"
    },
    "updatedReplicas": {
      "type": "integer"
    },
    "unavailableReplicas": {
      "type": "integer"
    },
    "generation": {
      "type": [
        "integer",
        "null"
      ]
    },
    "observedGeneration": {
      "type": [
        "integer",
        "null"
      ]
    },
    "paused": {
      "type": "boolean"
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "truncated": {
            "type": "boolean"
          },
          "lastTransitionTime": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "type",
          "status",
          "reason",
          "message",
          "truncated",
          "lastTransitionTime"
        ]
      }
    }
  },
  "required": [
    "name",
    "replicas",
    "readyReplicas",
    "availableReplicas",
    "updatedReplicas",
    "unavailableReplicas",
    "generation",
    "observedGeneration",
    "paused",
    "conditions"
  ]
}
