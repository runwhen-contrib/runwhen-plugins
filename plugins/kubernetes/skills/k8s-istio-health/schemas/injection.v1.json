{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Injection labels of the namespace",
  "type": "object",
  "properties": {
    "label": {
      "type": [
        "string",
        "null"
      ],
      "description": "Value of the istio-injection label"
    },
    "revision": {
      "type": [
        "string",
        "null"
      ],
      "description": "Value of the istio.io/rev label"
    },
    "dataplaneMode": {
      "type": [
        "string",
        "null"
      ],
      "description": "Value of the istio.io/dataplane-mode label (ambient)"
    },
    "excluded": {
      "type": "boolean",
      "description": "A namespace Istio never injects (kube-system, kube-public, kube-node-lease, local-path-storage), by name"
    },
    "enabled": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Whether the namespace labels ask for injection; null when the Namespace could not be read"
    },
    "mode": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "label",
        "revision",
        "disabled",
        "unlabelled",
        null
      ]
    }
  },
  "required": [
    "label",
    "revision",
    "dataplaneMode",
    "excluded",
    "enabled",
    "mode"
  ]
}
