{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LiteLLM readiness per pod",
  "description": "What each pod of the workload answered on /health/readiness through the API server's pod proxy. ready is true for 200 with status healthy, false for 503 or another status, null when the pod was not asked or the answer was an error. cache, litellmVersion and successCallbacks are present only when the proxy serves the detailed payload publicly (allow_public_health_readiness_details); db is in the public payload (connected, Not connected when no database is configured, disconnected).",
  "type": "object",
  "properties": {
    "workload": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "replicas": {
          "type": [
            "integer",
            "null"
          ]
        },
        "readyReplicas": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "name",
        "replicas",
        "readyReplicas"
      ],
      "additionalProperties": false
    },
    "podCount": {
      "type": "integer"
    },
    "truncated": {
      "type": "boolean",
      "description": "pods were cut at maxItems"
    },
    "readyCount": {
      "type": "integer"
    },
    "notReadyCount": {
      "type": "integer"
    },
    "pods": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "phase": {
            "type": [
              "string",
              "null"
            ]
          },
          "podReady": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "the pod's own Ready condition"
          },
          "port": {
            "type": "integer",
            "description": "the port asked"
          },
          "queried": {
            "type": "boolean",
            "description": "false for a pod that is not Running or was not asked before the deadline"
          },
          "ready": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "httpStatus": {
            "type": [
              "integer",
              "null"
            ]
          },
          "status": {
            "type": [
              "string",
              "null"
            ],
            "description": "the body's status text"
          },
          "db": {
            "type": [
              "string",
              "null"
            ],
            "description": "connected, Not connected (no database configured), disconnected"
          },
          "cache": {
            "type": [
              "string",
              "null"
            ],
            "description": "the cache type; null when none is configured or the payload is the public one"
          },
          "litellmVersion": {
            "type": [
              "string",
              "null"
            ]
          },
          "successCallbacks": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "maxItems": 50
          },
          "successCallbacksTruncated": {
            "type": "boolean"
          },
          "detailed": {
            "type": "boolean",
            "description": "the detailed payload (version, cache, callbacks) was present"
          },
          "truncated": {
            "type": "boolean",
            "description": "a text field was cut at 1024 characters"
          }
        },
        "required": [
          "name",
          "phase",
          "podReady",
          "port",
          "queried",
          "ready",
          "httpStatus",
          "status",
          "db",
          "cache",
          "litellmVersion",
          "successCallbacks",
          "successCallbacksTruncated",
          "detailed",
          "truncated"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "workload",
    "podCount",
    "truncated",
    "readyCount",
    "notReadyCount",
    "pods"
  ],
  "additionalProperties": false
}
