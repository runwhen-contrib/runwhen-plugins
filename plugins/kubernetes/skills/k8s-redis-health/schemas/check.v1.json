{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The SET, GET and DEL on the primary",
  "description": "ran is true when the sequence was sent to the one primary written to (the first by pod name); false for a dry run, whose reason is dry_run. A Redis with no ready pod, no primary or a cluster or sentinel mode fails the task instead. otherPrimaries names every other pod whose role is master. Steps that were not performed have performed false and ok null; a SET that answered nil (the key already existed) has reply (nil), ok false and no GET or DEL. latencyMs is the wall time of the kubectl exec running that one redis-cli command (exec round trip included).",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "maxLength": 1024
    },
    "ttlSeconds": {
      "type": "integer"
    },
    "dryRun": {
      "type": "boolean"
    },
    "ran": {
      "type": "boolean"
    },
    "reason": {
      "enum": [
        "dry_run",
        null
      ]
    },
    "primaries": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "pod": {
            "type": "string",
            "maxLength": 1024
          },
          "container": {
            "type": "string",
            "maxLength": 1024
          },
          "steps": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "object",
              "properties": {
                "step": {
                  "enum": [
                    "set",
                    "get",
                    "del"
                  ]
                },
                "performed": {
                  "type": "boolean"
                },
                "ok": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "latencyMs": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "reply": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 1024
                },
                "errorCode": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 1024
                }
              },
              "required": [
                "step",
                "performed",
                "ok",
                "latencyMs",
                "reply",
                "errorCode"
              ],
              "additionalProperties": false
            }
          },
          "allOk": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "valueMatches": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "keyRemoved": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "pod",
          "container",
          "steps",
          "allOk",
          "valueMatches",
          "keyRemoved"
        ],
        "additionalProperties": false
      }
    },
    "otherPrimaries": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "maxLength": 1024
      }
    }
  },
  "required": [
    "key",
    "ttlSeconds",
    "dryRun",
    "ran",
    "reason",
    "primaries",
    "otherPrimaries"
  ],
  "additionalProperties": false
}
