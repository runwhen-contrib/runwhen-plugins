{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The SET, GET and DEL on the primary",
  "description": "ran is true when the sequence was sent to at least one primary. reason says why it was not: dry_run, no_ready_pods, no_primary. Steps that were not performed have performed false and ok null. latencyMs is the wall time of the kubectl exec running that one redis-cli command (exec round trip included).",
  "type": "object",
  "properties": {
    "key": {
      "type": "string"
    },
    "ttlSeconds": {
      "type": "integer"
    },
    "dryRun": {
      "type": "boolean"
    },
    "ran": {
      "type": "boolean"
    },
    "reason": {
      "enum": [
        "dry_run",
        "no_ready_pods",
        "no_primary",
        null
      ]
    },
    "primaries": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "properties": {
          "pod": {
            "type": "string"
          },
          "container": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "object",
              "properties": {
                "step": {
                  "enum": [
                    "set",
                    "get",
                    "del"
                  ]
                },
                "performed": {
                  "type": "boolean"
                },
                "ok": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "latencyMs": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "reply": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "errorCode": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "step",
                "performed",
                "ok",
                "latencyMs",
                "reply",
                "errorCode"
              ],
              "additionalProperties": false
            }
          },
          "allOk": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "valueMatches": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "keyRemoved": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "pod",
          "container",
          "steps",
          "allOk",
          "valueMatches",
          "keyRemoved"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "key",
    "ttlSeconds",
    "dryRun",
    "ran",
    "reason",
    "primaries"
  ],
  "additionalProperties": false
}
