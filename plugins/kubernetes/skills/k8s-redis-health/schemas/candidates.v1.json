{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The role of each pod considered for the read-write check",
  "description": "role is null for a pod that is not ready (not asked) or whose role could not be read (error says why). mode is Redis' own redis_mode (standalone, cluster or sentinel).",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "pod": {
        "type": "string",
        "maxLength": 1024
      },
      "ready": {
        "type": "boolean"
      },
      "container": {
        "type": [
          "string",
          "null"
        ],
        "maxLength": 1024
      },
      "role": {
        "type": [
          "string",
          "null"
        ],
        "maxLength": 1024
      },
      "error": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 1024
          },
          "message": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "mode": {
        "type": [
          "string",
          "null"
        ],
        "maxLength": 1024
      }
    },
    "required": [
      "pod",
      "ready",
      "container",
      "role",
      "error",
      "mode"
    ],
    "additionalProperties": false
  }
}
