{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SeaweedFS S3 write probe",
  "description": "One probe object put, read back, deleted and confirmed gone through one S3 gateway pod, with no credentials. plan is what the task does (or would do, in a dry run); steps are what it did, each with ok and the error. passed is true when every step of the plan ran and succeeded and nothing is left behind (null in a dry run). anonymousWrite true: the gateway accepted an unauthenticated PUT (it is open for writes). contentMatches: the object read back equals what was written. leftBehind lists bucket/object paths a failed cleanup could not remove. The API server shows no body of a non-2xx answer, so an error message is the status, not SeaweedFS's explanation.",
  "type": "object",
  "properties": {
    "gateway": {
      "type": "object",
      "properties": {
        "pod": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        }
      },
      "required": [
        "pod",
        "port"
      ],
      "additionalProperties": false
    },
    "bucket": {
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "bucketExisted": {
      "type": "boolean"
    },
    "bucketCreated": {
      "type": "boolean"
    },
    "plan": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 10
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "error": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "name",
          "ok",
          "error"
        ],
        "additionalProperties": false
      },
      "maxItems": 50
    },
    "passed": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "contentMatches": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "anonymousWrite": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "cleanedUp": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "leftBehind": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 10
    }
  },
  "required": [
    "gateway",
    "bucket",
    "key",
    "bucketExisted",
    "bucketCreated",
    "plan",
    "steps",
    "passed",
    "contentMatches",
    "anonymousWrite",
    "cleanedUp",
    "leftBehind"
  ],
  "additionalProperties": false
}
