{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SeaweedFS volume slots",
  "description": "Volume slots from master /dir/status: max, free and used across the topology, per data node, and whether free is below the minFreeVolumeSlots setting. A data node with full true has as many volumes as it may hold.",
  "type": "object",
  "properties": {
    "version": {
      "type": [
        "string",
        "null"
      ]
    },
    "topologyId": {
      "type": [
        "string",
        "null"
      ]
    },
    "max": {
      "type": "integer"
    },
    "free": {
      "type": "integer"
    },
    "used": {
      "type": "integer"
    },
    "usedPercent": {
      "type": [
        "number",
        "null"
      ]
    },
    "minFreeSlots": {
      "type": "integer"
    },
    "belowMinFree": {
      "type": "boolean"
    },
    "dataNodeCount": {
      "type": "integer"
    },
    "dataNodesTruncated": {
      "type": "boolean"
    },
    "dataNodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "dataCenter": {
            "type": [
              "string",
              "null"
            ]
          },
          "rack": {
            "type": [
              "string",
              "null"
            ]
          },
          "volumes": {
            "type": "integer"
          },
          "ecShards": {
            "type": "integer"
          },
          "max": {
            "type": "integer"
          },
          "full": {
            "type": "boolean"
          }
        },
        "required": [
          "url",
          "dataCenter",
          "rack",
          "volumes",
          "ecShards",
          "max",
          "full"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "topologyId",
    "max",
    "free",
    "used",
    "usedPercent",
    "minFreeSlots",
    "belowMinFree",
    "dataNodeCount",
    "dataNodesTruncated",
    "dataNodes"
  ],
  "additionalProperties": false
}
