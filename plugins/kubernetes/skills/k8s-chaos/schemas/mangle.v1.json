{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chaos Service mangle",
  "description": "Each Service was changed (selector: the first selector key's value replaced; port: ports[0].port replaced, targetPort kept), watched, held for revertAfter and restored from the original spec; restore.verified is true when a read afterwards found the original selector and ports back. A Service that could not be restored fails the task with an internal error carrying the original spec. Ready endpoints are counted from the Service's EndpointSlices before, during and after restore; endpointsDropped is whether the count fell (a port change does not remove endpoints). On a dry run applied is false, nothing was changed and the during/after fields are null.",
  "type": "object",
  "properties": {
    "applied": {
      "type": "boolean"
    },
    "mode": {
      "enum": [
        "selector",
        "port"
      ]
    },
    "revertAfterMs": {
      "type": "integer"
    },
    "serviceCount": {
      "type": "integer"
    },
    "services": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "change": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string"
              },
              "from": {
                "type": [
                  "string",
                  "integer",
                  "null"
                ]
              },
              "to": {
                "type": [
                  "string",
                  "integer"
                ]
              }
            },
            "required": [
              "field",
              "from",
              "to"
            ],
            "additionalProperties": false
          },
          "readyEndpointsBefore": {
            "type": [
              "integer",
              "null"
            ]
          },
          "readyEndpointsDuring": {
            "type": [
              "integer",
              "null"
            ]
          },
          "readyEndpointsAfterRestore": {
            "type": [
              "integer",
              "null"
            ]
          },
          "endpointsDropped": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "heldMs": {
            "type": [
              "integer",
              "null"
            ]
          },
          "restore": {
            "type": "object",
            "properties": {
              "attempted": {
                "type": "boolean"
              },
              "restored": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "verified": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "attempted",
              "restored",
              "verified",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "name",
          "change",
          "readyEndpointsBefore",
          "readyEndpointsDuring",
          "readyEndpointsAfterRestore",
          "endpointsDropped",
          "heldMs",
          "restore"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "applied",
    "mode",
    "revertAfterMs",
    "serviceCount",
    "services"
  ],
  "additionalProperties": false
}
