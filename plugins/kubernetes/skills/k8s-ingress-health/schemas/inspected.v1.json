{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "What the events were matched against",
  "type": "object",
  "properties": {
    "ingress": {
      "type": "string",
      "maxLength": 1024
    },
    "services": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1024
      },
      "maxItems": 100
    },
    "servicesLookedUp": {
      "type": "boolean"
    },
    "servicesTruncated": {
      "type": "boolean"
    }
  },
  "required": [
    "ingress",
    "services",
    "servicesLookedUp",
    "servicesTruncated"
  ],
  "additionalProperties": false
}
