{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TLS hosts and the Secret each names (the Secret is not read)",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "hosts": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 1024
            },
            "maxItems": 50
          },
          "secretName": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "hosts",
          "secretName",
          "truncated"
        ],
        "additionalProperties": false
      }
    },
    "total": {
      "type": "integer"
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "required": [
    "items",
    "total",
    "truncated"
  ],
  "additionalProperties": false
}
