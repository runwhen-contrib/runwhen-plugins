{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TLS hosts and the Secret each names (the Secret is not read)",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "hosts": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "secretName": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "hosts",
      "secretName"
    ],
    "additionalProperties": false
  }
}
