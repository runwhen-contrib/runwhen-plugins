{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GCP load balancer object names the GKE controller recorded on the Ingress",
  "type": "object",
  "properties": {
    "present": {
      "type": "boolean"
    },
    "forwardingRule": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1024
    },
    "httpsForwardingRule": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1024
    },
    "urlMap": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1024
    },
    "targetProxy": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1024
    },
    "httpsTargetProxy": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1024
    },
    "staticIp": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1024
    }
  },
  "required": [
    "present",
    "forwardingRule",
    "httpsForwardingRule",
    "urlMap",
    "targetProxy",
    "httpsTargetProxy",
    "staticIp"
  ],
  "additionalProperties": false
}
