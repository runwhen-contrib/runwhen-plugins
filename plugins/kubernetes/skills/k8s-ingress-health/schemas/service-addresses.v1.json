{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Each backend Service's type and LoadBalancer address against the Ingress's",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "service": {
        "type": "string"
      },
      "exists": {
        "type": [
          "boolean",
          "null"
        ]
      },
      "type": {
        "type": [
          "string",
          "null"
        ]
      },
      "addresses": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "ip": {
              "type": [
                "string",
                "null"
              ]
            },
            "hostname": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "ip",
            "hostname"
          ],
          "additionalProperties": false
        }
      },
      "differsFromIngress": {
        "type": [
          "boolean",
          "null"
        ]
      }
    },
    "required": [
      "service",
      "exists",
      "type",
      "addresses",
      "differsFromIngress"
    ],
    "additionalProperties": false
  }
}
