{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The Ingress's assigned address and class",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "namespace": {
      "type": [
        "string",
        "null"
      ]
    },
    "ingressClassName": {
      "type": [
        "string",
        "null"
      ]
    },
    "classAnnotation": {
      "type": [
        "string",
        "null"
      ]
    },
    "addresses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ip": {
            "type": [
              "string",
              "null"
            ]
          },
          "hostname": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "ip",
          "hostname"
        ],
        "additionalProperties": false
      }
    },
    "assigned": {
      "type": "boolean"
    }
  },
  "required": [
    "name",
    "namespace",
    "ingressClassName",
    "classAnnotation",
    "addresses",
    "assigned"
  ],
  "additionalProperties": false
}
