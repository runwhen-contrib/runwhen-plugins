{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Warning events about the Ingress and its backend Services, grouped by object and reason",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "maxLength": 1024
          },
          "name": {
            "type": "string",
            "maxLength": 1024
          },
          "type": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024
          },
          "count": {
            "type": "integer"
          },
          "firstSeen": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024
          },
          "lastSeen": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024
          },
          "message": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024
          },
          "reportingComponent": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "kind",
          "name",
          "type",
          "reason",
          "count",
          "firstSeen",
          "lastSeen",
          "message",
          "reportingComponent",
          "truncated"
        ],
        "additionalProperties": false
      }
    },
    "total": {
      "type": "integer"
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "required": [
    "items",
    "total",
    "truncated"
  ],
  "additionalProperties": false
}
