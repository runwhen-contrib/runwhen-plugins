{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Each backend the Ingress routes to and what its Service and endpoints look like",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "enum": [
              "rule",
              "default"
            ]
          },
          "host": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024
          },
          "path": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024
          },
          "pathType": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024
          },
          "kind": {
            "enum": [
              "service",
              "resource"
            ]
          },
          "service": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 1024
                  },
                  "portNumber": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "portName": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 1024
                  }
                },
                "required": [
                  "name",
                  "portNumber",
                  "portName"
                ],
                "additionalProperties": false
              }
            ]
          },
          "resource": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "apiGroup": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 1024
                  },
                  "kind": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 1024
                  },
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 1024
                  }
                },
                "required": [
                  "apiGroup",
                  "kind",
                  "name"
                ],
                "additionalProperties": false
              }
            ]
          },
          "serviceExists": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "serviceType": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024
          },
          "hasSelector": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "publishNotReady": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "portExists": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "targetPort": {
            "type": [
              "string",
              "integer",
              "null"
            ],
            "maxLength": 1024
          },
          "protocol": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1024
          },
          "endpoints": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "ready": {
                    "type": "integer"
                  },
                  "notReady": {
                    "type": "integer"
                  },
                  "serving": {
                    "type": "integer"
                  },
                  "terminating": {
                    "type": "integer"
                  },
                  "slices": {
                    "type": "integer"
                  }
                },
                "required": [
                  "ready",
                  "notReady",
                  "serving",
                  "terminating",
                  "slices"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "source",
          "host",
          "path",
          "pathType",
          "kind",
          "service",
          "resource",
          "serviceExists",
          "serviceType",
          "hasSelector",
          "publishNotReady",
          "portExists",
          "targetPort",
          "protocol",
          "endpoints"
        ],
        "additionalProperties": false
      }
    },
    "total": {
      "type": "integer"
    },
    "truncated": {
      "type": "boolean"
    },
    "servicesTruncated": {
      "type": "boolean"
    }
  },
  "required": [
    "items",
    "total",
    "truncated",
    "servicesTruncated"
  ],
  "additionalProperties": false
}
