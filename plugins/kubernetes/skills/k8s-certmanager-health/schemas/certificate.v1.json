{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Certificate readiness, validity window and spec facts",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "namespace": {
      "type": [
        "string",
        "null"
      ]
    },
    "generation": {
      "type": [
        "integer",
        "null"
      ]
    },
    "ready": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "status": {
              "type": [
                "string",
                "null"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "message": {
              "type": [
                "string",
                "null"
              ]
            },
            "truncated": {
              "type": "boolean"
            },
            "lastTransitionTime": {
              "type": [
                "string",
                "null"
              ]
            },
            "observedGeneration": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "type",
            "status",
            "reason",
            "message",
            "truncated",
            "lastTransitionTime",
            "observedGeneration"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "issuing": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "status": {
              "type": [
                "string",
                "null"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "message": {
              "type": [
                "string",
                "null"
              ]
            },
            "truncated": {
              "type": "boolean"
            },
            "lastTransitionTime": {
              "type": [
                "string",
                "null"
              ]
            },
            "observedGeneration": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "type",
            "status",
            "reason",
            "message",
            "truncated",
            "lastTransitionTime",
            "observedGeneration"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "truncated": {
            "type": "boolean"
          },
          "lastTransitionTime": {
            "type": [
              "string",
              "null"
            ]
          },
          "observedGeneration": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "type",
          "status",
          "reason",
          "message",
          "truncated",
          "lastTransitionTime",
          "observedGeneration"
        ],
        "additionalProperties": false
      },
      "maxItems": 50
    },
    "notBefore": {
      "type": [
        "string",
        "null"
      ]
    },
    "notAfter": {
      "type": [
        "string",
        "null"
      ]
    },
    "renewalTime": {
      "type": [
        "string",
        "null"
      ]
    },
    "renewalTimePassed": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "revision": {
      "type": [
        "integer",
        "null"
      ]
    },
    "lastFailureTime": {
      "type": [
        "string",
        "null"
      ]
    },
    "expiresInDays": {
      "type": [
        "number",
        "null"
      ],
      "description": "Days until status.notAfter (negative once passed); null before the first issuance"
    },
    "expired": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "notAfter has passed; null before the first issuance"
    },
    "expiringSoon": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "notAfter is within expiryWarningDays or has passed; null before the first issuance"
    },
    "expiryWarningDays": {
      "type": "number"
    },
    "commonName": {
      "type": [
        "string",
        "null"
      ]
    },
    "dnsNameCount": {
      "type": "integer"
    },
    "dnsNames": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 50
    },
    "secretName": {
      "type": [
        "string",
        "null"
      ],
      "description": "Name of the Secret that holds the key pair; the Secret itself is never read"
    },
    "duration": {
      "type": [
        "string",
        "null"
      ]
    },
    "renewBefore": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "name",
    "namespace",
    "generation",
    "ready",
    "issuing",
    "conditions",
    "notBefore",
    "notAfter",
    "renewalTime",
    "renewalTimePassed",
    "revision",
    "lastFailureTime",
    "expiresInDays",
    "expired",
    "expiringSoon",
    "expiryWarningDays",
    "commonName",
    "dnsNameCount",
    "dnsNames",
    "secretName",
    "duration",
    "renewBefore"
  ],
  "additionalProperties": false
}
