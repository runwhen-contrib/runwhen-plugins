{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ACME Orders of the Certificate's requests",
  "type": [
    "object",
    "null"
  ],
  "properties": {
    "applicable": {
      "type": "boolean",
      "description": "false when the acme.cert-manager.io Order type is not installed"
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "request": {
            "type": "string"
          },
          "state": {
            "type": [
              "string",
              "null"
            ],
            "description": "pending, ready, valid, invalid, expired or errored"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "truncated": {
            "type": "boolean"
          },
          "failureTime": {
            "type": [
              "string",
              "null"
            ]
          },
          "authorizationCount": {
            "type": "integer"
          }
        },
        "required": [
          "name",
          "request",
          "state",
          "reason",
          "truncated",
          "failureTime",
          "authorizationCount"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "applicable",
    "reason",
    "items"
  ],
  "additionalProperties": false
}
