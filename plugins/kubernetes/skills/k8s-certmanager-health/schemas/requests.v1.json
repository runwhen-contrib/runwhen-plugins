{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CertificateRequests owned by the Certificate, newest revision first",
  "type": "array",
  "items": {
    "title": "One CertificateRequest",
    "type": "object",
    "properties": {
      "name": {
        "type": "string"
      },
      "creationTimestamp": {
        "type": [
          "string",
          "null"
        ]
      },
      "revision": {
        "type": [
          "integer",
          "null"
        ]
      },
      "failureTime": {
        "type": [
          "string",
          "null"
        ]
      },
      "issuerRef": {
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "type": "string"
          },
          "group": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "kind",
          "group"
        ],
        "additionalProperties": false
      },
      "ready": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "status": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "message": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "truncated": {
                "type": "boolean"
              },
              "lastTransitionTime": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "observedGeneration": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            },
            "required": [
              "type",
              "status",
              "reason",
              "message",
              "truncated",
              "lastTransitionTime",
              "observedGeneration"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "approved": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "status": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "message": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "truncated": {
                "type": "boolean"
              },
              "lastTransitionTime": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "observedGeneration": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            },
            "required": [
              "type",
              "status",
              "reason",
              "message",
              "truncated",
              "lastTransitionTime",
              "observedGeneration"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "denied": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "status": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "message": {
                "type": [
                  "string",
