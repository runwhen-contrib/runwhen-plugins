                "type": "boolean"
              },
              "lastTransitionTime": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "observedGeneration": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            },
            "required": [
              "type",
              "status",
              "reason",
              "message",
              "truncated",
              "lastTransitionTime",
              "observedGeneration"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
