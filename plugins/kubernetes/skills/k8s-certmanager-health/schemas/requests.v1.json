        ]
      },
      "invalidRequest": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "status": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reason": {
                "type": [
                  "string",
