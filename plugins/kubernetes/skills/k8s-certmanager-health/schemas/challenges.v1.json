{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ACME Challenges of the Certificate's Orders",
  "type": [
    "object",
    "null"
  ],
  "properties": {
    "applicable": {
      "type": "boolean",
      "description": "false when the acme.cert-manager.io Challenge type is not installed"
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "order": {
            "type": "string"
          },
          "type": {
            "type": [
              "string",
              "null"
            ]
          },
          "dnsName": {
            "type": [
              "string",
              "null"
            ]
          },
          "wildcard": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "state": {
            "type": [
              "string",
              "null"
            ],
            "description": "pending, valid, ready, processing, invalid, expired or errored"
          },
          "presented": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "processing": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why validation is waiting or failed (status.reason)"
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "order",
          "type",
          "dnsName",
          "wildcard",
          "state",
          "presented",
          "processing",
          "reason",
          "truncated"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "applicable",
    "reason",
    "items"
  ],
  "additionalProperties": false
}
