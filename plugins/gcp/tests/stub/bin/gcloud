#!/usr/bin/env -S python3 -I
"""A stand-in for gcloud that answers from canned scenarios (tests/stub/scenarios). It never contacts
Google. Run it through ../harness.py; see ../README.md and ../stublib.py."""

import importlib.util
import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
spec = importlib.util.spec_from_file_location("stublib", os.path.join(os.path.dirname(HERE), "stublib.py"))
stublib = importlib.util.module_from_spec(spec)
spec.loader.exec_module(stublib)

if __name__ == "__main__":
    stublib.serve("gcloud", sys.argv[1:])
