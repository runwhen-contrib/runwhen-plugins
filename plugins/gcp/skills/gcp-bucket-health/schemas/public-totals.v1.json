{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Counts over the buckets examined by public-access",
  "type": "object",
  "properties": {
    "examined": {"type": "integer", "description": "Buckets with an entry in access"},
    "total": {"type": "integer", "description": "Buckets the target covers"},
    "omitted": {"type": "integer", "description": "Buckets left out of the run by maxItems"},
    "complete": {"type": "boolean", "description": "Every bucket of the target has an entry (nothing omitted by maxItems, nothing failed) and none is undecided (unknown is 0)"},
    "publicBuckets": {"type": "integer", "description": "Buckets with publicGrant true"},
    "unknown": {"type": "integer", "description": "Buckets with publicGrant null"},
    "threshold": {"type": "integer", "description": "The publicBucketThreshold setting"},
    "overThreshold": {"type": "boolean", "description": "publicBuckets is above the threshold"}
  },
  "required": ["examined", "total", "omitted", "complete", "publicBuckets", "unknown", "threshold", "overThreshold"],
  "additionalProperties": false
}
