{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "State, SKU and instance count of an App Service plan",
  "type": "object",
  "properties": {
    "plan": {
      "type": "string"
    },
    "kind": {
      "type": [
        "string",
        "null"
      ],
      "description": "linux, app, functionapp ..."
    },
    "isLinux": {
      "type": "boolean"
    },
    "location": {
      "type": [
        "string",
        "null"
      ]
    },
    "planStatus": {
      "type": "string",
      "description": "Ready, Pending or Creating, as Azure reports it"
    },
    "ready": {
      "type": "boolean",
      "description": "planStatus is Ready"
    },
    "provisioningState": {
      "type": [
        "string",
        "null"
      ]
    },
    "sku": {
      "type": "object",
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "tier": {
          "type": [
            "string",
            "null"
          ]
        },
        "size": {
          "type": [
            "string",
            "null"
          ]
        },
        "family": {
          "type": [
            "string",
            "null"
          ]
        },
        "capacity": {
          "type": [
            "integer",
            "null"
          ],
          "description": "The instance count the SKU is set to"
        }
      },
      "required": [
        "name",
        "tier",
        "size",
        "family",
        "capacity"
      ],
      "additionalProperties": false
    },
    "instanceCount": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Instances the plan runs: numberOfWorkers, else sku.capacity"
    },
    "maximumNumberOfWorkers": {
      "type": [
        "integer",
        "null"
      ],
      "description": "The most instances this SKU can scale out to"
    },
    "numberOfSites": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Apps (web apps and function apps) on the plan"
    },
    "elasticScaleEnabled": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "maximumElasticWorkerCount": {
      "type": [
        "integer",
        "null"
      ]
    },
    "perSiteScaling": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "zoneRedundant": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "isSpot": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "inAppServiceEnvironment": {
      "type": "boolean",
      "description": "The plan lives in an App Service Environment"
    }
  },
  "required": [
    "plan",
    "kind",
    "isLinux",
    "location",
    "planStatus",
    "ready",
    "provisioningState",
    "sku",
    "instanceCount",
    "maximumNumberOfWorkers",
    "numberOfSites",
    "elasticScaleEnabled",
    "maximumElasticWorkerCount",
    "perSiteScaling",
    "zoneRedundant",
    "isSpot",
    "inAppServiceEnvironment"
  ],
  "additionalProperties": false
}
