        "metric",
        "hasData",
        "thresholdPercent",
        "grains",
        "grainsWithData",
        "grainsMissing",
        "averageMin",
        "averageMax",
        "averageLast",
        "lastGrainMissing",
        "peakMax",
        "grainsAverageOverThreshold",
        "averageOverThreshold",
        "grainsPeakOverThreshold",
        "peakOverThreshold",
        "points",
