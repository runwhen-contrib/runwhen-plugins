{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Azure Resource Health of the AKS cluster",
  "type": "object",
  "properties": {
    "cluster": {
      "type": "string"
    },
    "availabilityState": {
      "type": "string",
      "description": "As Resource Health reports it: Available, Unavailable, Degraded or Unknown"
    },
    "healthy": {
      "type": "boolean",
      "description": "availabilityState is Available"
    },
    "summary": {
      "type": "string",
      "description": "Resource Health's own summary, cut to 1024 characters"
    },
    "detailedStatus": {
      "type": "string",
      "description": "Cut to 1024 characters; empty when Azure gives none"
    },
    "reasonType": {
      "type": [
        "string",
        "null"
      ]
    },
    "reasonChronicity": {
      "type": [
        "string",
        "null"
      ]
    },
    "occurredTime": {
      "type": [
        "string",
        "null"
      ]
    },
    "reportedTime": {
      "type": [
        "string",
        "null"
      ]
    },
    "serviceImpactingEvents": {
      "type": "integer",
      "description": "How many service-impacting events Azure lists for the cluster"
    },
    "truncated": {
      "type": "boolean",
      "description": "summary or detailedStatus was cut"
    }
  },
  "required": [
    "cluster",
    "availabilityState",
    "healthy",
    "summary",
    "detailedStatus",
    "reasonType",
    "reasonChronicity",
    "occurredTime",
    "reportedTime",
    "serviceImpactingEvents",
    "truncated"
  ],
  "additionalProperties": false
}
