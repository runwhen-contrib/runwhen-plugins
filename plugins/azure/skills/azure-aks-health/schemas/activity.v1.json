{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Failed operations on an AKS cluster in the Activity Log",
  "type": "object",
  "properties": {
    "cluster": {
      "type": "string"
    },
    "windowSeconds": {
      "type": "integer"
    },
    "start": {
      "type": "string"
    },
    "end": {
      "type": "string"
    },
    "scanLimit": {
      "type": "integer",
      "description": "The activityScanLimit setting"
    },
    "eventsScanned": {
      "type": "integer",
      "description": "Failed events read for the cluster's resource group"
    },
    "scanCut": {
      "type": "boolean",
      "description": "The group has more failed events than scanLimit: the cluster's list may be incomplete and an empty one proves nothing"
    },
    "eventsForCluster": {
      "type": "integer",
      "description": "Of those, about the cluster or something under it"
    },
    "eventsForOtherResources": {
      "type": "integer"
    },
    "failures": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "operation": {
                "type": "string"
              },
              "target": {
                "type": "string",
                "description": "cluster, or the rest of the resource id under it (agentPools/<pool>)"
              },
              "level": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "subStatus": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "errorCode": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "message": {
                "type": "string",
                "description": "The newest event's error message, cut to 1024 characters"
              },
              "truncated": {
                "type": "boolean"
              },
              "count": {
                "type": "integer"
              },
              "firstSeen": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "lastSeen": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "operation",
              "target",
              "level",
              "subStatus",
              "errorCode",
              "message",
              "truncated",
              "count",
              "firstSeen",
              "lastSeen"
            ],
            "additionalProperties": false
          },
          "description": "Groups of failed operations, most frequent first, cut to maxItems"
        },
        "total": {
          "type": "integer",
          "description": "Entries found"
        },
        "omitted": {
          "type": "integer",
          "description": "Entries left out of items by maxItems"
        }
      },
      "required": [
        "items",
        "total",
        "omitted"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "cluster",
    "windowSeconds",
    "start",
    "end",
    "scanLimit",
    "eventsScanned",
    "scanCut",
    "eventsForCluster",
    "eventsForOtherResources",
    "failures"
  ],
  "additionalProperties": false
}
