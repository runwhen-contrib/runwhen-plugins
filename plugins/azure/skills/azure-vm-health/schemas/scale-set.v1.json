{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A scale set's model and configuration",
  "type": "object",
  "properties": {
    "scaleSet": {
      "type": "string"
    },
    "location": {
      "type": [
        "string",
        "null"
      ]
    },
    "provisioningState": {
      "type": [
        "string",
        "null"
      ]
    },
    "orchestrationMode": {
      "type": [
        "string",
        "null"
      ],
      "description": "Uniform or Flexible"
    },
    "sku": {
      "type": "object",
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "tier": {
          "type": [
            "string",
            "null"
          ]
        },
        "capacity": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "tier",
        "capacity"
      ],
      "additionalProperties": false
    },
    "zones": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 50
    },
    "zoneBalance": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "platformFaultDomainCount": {
      "type": [
        "integer",
        "null"
      ]
    },
    "singlePlacementGroup": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "overprovision": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "upgradeMode": {
      "type": [
        "string",
        "null"
      ],
      "description": "Manual, Automatic or Rolling"
    },
    "automaticOsUpgradeEnabled": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "rollingUpgradeMaxBatchPercent": {
      "type": [
        "integer",
        "null"
      ]
    },
    "rollingUpgradeMaxUnhealthyPercent": {
      "type": [
        "integer",
        "null"
      ]
    },
    "automaticRepairsEnabled": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "automaticRepairsGracePeriod": {
      "type": [
        "string",
        "null"
      ]
    },
    "scaleInRules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 50
    },
    "osType": {
      "type": [
        "string",
        "null"
      ]
    },
    "image": {
      "type": "object",
      "properties": {
        "publisher": {
          "type": [
            "string",
            "null"
          ]
        },
        "offer": {
          "type": [
            "string",
            "null"
          ]
        },
        "sku": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "exactVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "fromGalleryOrCustomImage": {
          "type": "boolean",
          "description": "The image is a gallery or custom image id (not returned)"
        }
      },
      "required": [
        "publisher",
        "offer",
        "sku",
        "version",
        "exactVersion",
        "fromGalleryOrCustomImage"
      ],
      "additionalProperties": false
    },
    "hasLoadBalancerHealthProbe": {
      "type": "boolean"
    },
    "extensions": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "typeHandlerVersion": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "provisioningState": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "name",
              "type",
              "typeHandlerVersion",
              "provisioningState"
            ],
            "additionalProperties": false
          }
        },
        "total": {
          "type": "integer",
          "description": "Extensions found"
        },
        "omitted": {
          "type": "integer",
          "description": "Extensions left out of items by maxItems or the nested limit"
        }
      },
      "required": [
        "items",
        "total",
        "omitted"
      ],
      "additionalProperties": false
    },
    "tags": {
      "type": "integer",
      "description": "How many tags the scale set has"
    }
  },
  "required": [
    "scaleSet",
    "location",
    "provisioningState",
    "orchestrationMode",
    "sku",
    "zones",
    "zoneBalance",
    "platformFaultDomainCount",
    "singlePlacementGroup",
    "overprovision",
    "upgradeMode",
    "automaticOsUpgradeEnabled",
    "rollingUpgradeMaxBatchPercent",
    "rollingUpgradeMaxUnhealthyPercent",
    "automaticRepairsEnabled",
    "automaticRepairsGracePeriod",
    "scaleInRules",
    "osType",
    "image",
    "hasLoadBalancerHealthProbe",
    "extensions",
    "tags"
  ],
  "additionalProperties": false
}
