{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Critical, Error and Warning activity log entries of a virtual machine or scale set over a window",
  "type": "object",
  "properties": {
    "resource": {
      "type": "string"
    },
    "resourceType": {
      "enum": [
        "azure/virtual-machine",
        "azure/vm-scale-set"
      ]
    },
    "windowSeconds": {
      "type": "integer"
    },
    "scanLimit": {
      "type": "integer"
    },
    "eventsScanned": {
      "type": "integer",
      "description": "Events read from the resource group's log, of every level and every resource"
    },
    "scanCut": {
      "type": "boolean",
      "description": "The group's log held more events than scanLimit: the resource's list may be incomplete and an empty one proves nothing"
    },
    "eventsForResource": {
      "type": "integer",
      "description": "Of those scanned, the events about this resource or something under it, of every level"
    },
    "eventsForOtherResources": {
      "type": "integer"
    },
    "counts": {
      "type": "object",
      "properties": {
        "Critical": {
          "type": "integer"
        },
        "Error": {
          "type": "integer"
        },
        "Warning": {
          "type": "integer"
        }
      },
      "required": [
        "Critical",
        "Error",
        "Warning"
      ],
      "additionalProperties": false
    },
    "events": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "time": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "level": {
                "type": "string"
              },
              "target": {
                "type": "string",
                "description": "resource for the virtual machine or scale set itself, else the rest of the resource id (extensions/CustomScript)"
              },
              "operation": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "subStatus": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "message": {
                "type": "string",
                "description": "Cut to 1024 characters"
              },
              "correlationId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "truncated": {
                "type": "boolean"
              }
            },
            "required": [
              "time",
              "level",
              "target",
              "operation",
              "status",
              "subStatus",
              "message",
              "correlationId",
              "truncated"
            ],
            "additionalProperties": false
          }
        },
        "total": {
          "type": "integer",
          "description": "Critical, Error and Warning events found"
        },
        "omitted": {
          "type": "integer",
          "description": "Critical, Error and Warning events left out of items by maxItems or the nested limit"
        }
      },
      "required": [
        "items",
        "total",
        "omitted"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "resource",
    "resourceType",
    "windowSeconds",
    "scanLimit",
    "eventsScanned",
    "scanCut",
    "eventsForResource",
    "eventsForOtherResources",
    "counts",
    "events"
  ],
  "additionalProperties": false
}
