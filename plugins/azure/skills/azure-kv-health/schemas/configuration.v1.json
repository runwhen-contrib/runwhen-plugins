{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The vault's protection and network configuration",
  "type": "object",
  "properties": {
    "vault": {
      "type": "string"
    },
    "resourceGroup": {
      "type": [
        "string",
        "null"
      ]
    },
    "location": {
      "type": [
        "string",
        "null"
      ]
    },
    "sku": {
      "type": [
        "string",
        "null"
      ]
    },
    "provisioningState": {
      "type": [
        "string",
        "null"
      ]
    },
    "softDeleteEnabled": {
      "type": "boolean",
      "description": "False only when Azure reports enableSoftDelete as false; null (newer API versions) means on"
    },
    "softDeleteRetentionDays": {
      "type": [
        "integer",
        "null"
      ]
    },
    "purgeProtectionEnabled": {
      "type": "boolean",
      "description": "True only when enablePurgeProtection is true; null means it was never enabled"
    },
    "rbacAuthorization": {
      "type": "boolean",
      "description": "Azure RBAC governs the data plane; false means access policies do"
    },
    "publicNetworkAccess": {
      "type": [
        "string",
        "null"
      ]
    },
    "networkAclDefaultAction": {
      "type": [
        "string",
        "null"
      ]
    },
    "ipRuleCount": {
      "type": "integer"
    },
    "virtualNetworkRuleCount": {
      "type": "integer"
    },
    "privateEndpointConnectionCount": {
      "type": "integer"
    },
    "accessPolicyCount": {
      "type": "integer",
      "description": "How many access policies the vault holds (their content is not returned)"
    },
    "enabledForDeployment": {
      "type": "boolean"
    },
    "enabledForDiskEncryption": {
      "type": "boolean"
    },
    "enabledForTemplateDeployment": {
      "type": "boolean"
    }
  },
  "required": [
    "vault",
    "resourceGroup",
    "location",
    "sku",
    "provisioningState",
    "softDeleteEnabled",
    "softDeleteRetentionDays",
    "purgeProtectionEnabled",
    "rbacAuthorization",
    "publicNetworkAccess",
    "networkAclDefaultAction",
    "ipRuleCount",
    "virtualNetworkRuleCount",
    "privateEndpointConnectionCount",
    "accessPolicyCount",
    "enabledForDeployment",
    "enabledForDiskEncryption",
    "enabledForTemplateDeployment"
  ],
  "additionalProperties": false
}
