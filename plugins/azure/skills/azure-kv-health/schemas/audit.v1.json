{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Failed Key Vault operations in the audit log, and whether the audit log can be read at all",
  "type": "object",
  "properties": {
    "vault": {
      "type": "string"
    },
    "windowSeconds": {
      "type": "integer"
    },
    "diagnosticSettings": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "auditEvent": {
            "type": "boolean",
            "description": "The AuditEvent category is enabled"
          },
          "logAnalytics": {
            "type": "boolean"
          },
          "storageAccount": {
            "type": "boolean"
          },
          "eventHub": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "auditEvent",
          "logAnalytics",
          "storageAccount",
          "eventHub"
        ],
        "additionalProperties": false
      }
    },
    "diagnosticSettingsOmitted": {
      "type": "integer"
    },
    "auditLoggingToWorkspace": {
      "type": "boolean",
      "description": "Some setting sends AuditEvent to a Log Analytics workspace. False: the log cannot be queried here, and failures is null"
    },
    "workspacesQueried": {
      "type": "integer"
    },
    "workspacesSkipped": {
      "type": "integer",
      "description": "Workspaces beyond the first 3 that were not queried"
    },
    "failureCount": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Failed operations (HTTP status 400 or above) in the window; null when no workspace was queried"
    },
    "failures": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "operation": {
                    "type": "string"
                  },
                  "httpStatusCode": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "count": {
                    "type": "integer"
                  },
                  "firstSeen": {
                    "type": "string"
                  },
                  "lastSeen": {
                    "type": "string"
                  }
                },
                "required": [
                  "operation",
                  "httpStatusCode",
                  "count",
                  "firstSeen",
                  "lastSeen"
                ],
                "additionalProperties": false
              }
            },
            "total": {
              "type": "integer"
            },
            "omitted": {
              "type": "integer"
            }
          },
          "required": [
            "items",
            "total",
            "omitted"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Failures grouped by operation and status, most first, cut to maxItems; null when no workspace was queried. An empty list with workspacesQueried above zero means there were none"
    }
  },
  "required": [
    "vault",
    "windowSeconds",
    "diagnosticSettings",
    "diagnosticSettingsOmitted",
    "auditLoggingToWorkspace",
    "workspacesQueried",
    "workspacesSkipped",
    "failureCount",
    "failures"
  ],
  "additionalProperties": false
}
