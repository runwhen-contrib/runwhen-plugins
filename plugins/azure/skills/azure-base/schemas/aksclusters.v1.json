{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The subscription's AKS clusters across its resource groups",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "resourceGroup": {"type": "string"},
          "location": {"type": "string"},
          "id": {"type": "string", "description": "The ARM resource id"}
        },
        "required": ["name", "resourceGroup", "location", "id"],
        "additionalProperties": false
      }
    },
    "total": {"type": "integer", "description": "AKS clusters found"},
    "omitted": {"type": "integer", "description": "AKS clusters left out of items by maxItems"}
  },
  "required": ["items", "total", "omitted"],
  "additionalProperties": false
}
