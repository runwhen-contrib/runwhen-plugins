{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The subscription's resource groups",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string", "description": "As ARM spells it; the identity uses it lower-cased"},
          "location": {"type": "string"},
          "id": {"type": "string", "description": "The ARM resource id"},
          "keyvaults": {"type": ["integer", "null"], "description": "Key Vaults found in the group; null when the group's vaults could not be listed"}
        },
        "required": ["name", "location", "id", "keyvaults"],
        "additionalProperties": false
      }
    },
    "total": {"type": "integer", "description": "Resource groups found"},
    "omitted": {"type": "integer", "description": "Resource groups left out of items by maxItems"}
  },
  "required": ["items", "total", "omitted"],
  "additionalProperties": false
}
