{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The subscription's App Service plans across its resource groups",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "resourceGroup": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "description": "The ARM resource id"
          },
          "kind": {
            "type": "string",
            "description": "linux, app, functionapp ...; empty when Azure gives none"
          },
          "skuName": {
            "type": "string"
          },
          "skuTier": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "resourceGroup",
          "location",
          "id",
          "kind",
          "skuName",
          "skuTier"
        ],
        "additionalProperties": false
      }
    },
    "total": {
      "type": "integer",
      "description": "App Service plans found"
    },
    "omitted": {
      "type": "integer",
      "description": "App Service plans left out of items by maxItems"
    }
  },
  "required": [
    "items",
    "total",
    "omitted"
  ],
  "additionalProperties": false
}
