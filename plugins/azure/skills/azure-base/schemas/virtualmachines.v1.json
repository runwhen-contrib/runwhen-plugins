{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The subscription's virtual machines across its resource groups",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "resourceGroup": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "description": "The ARM resource id"
          },
          "osType": {
            "type": "string",
            "description": "Linux or Windows as the VM's OS disk says; empty when it does not"
          }
        },
        "required": [
          "name",
          "resourceGroup",
          "location",
          "id",
          "osType"
        ],
        "additionalProperties": false
      }
    },
    "total": {
      "type": "integer",
      "description": "Virtual machines found"
    },
    "omitted": {
      "type": "integer",
      "description": "Virtual machines left out of items by maxItems"
    }
  },
  "required": [
    "items",
    "total",
    "omitted"
  ],
  "additionalProperties": false
}
